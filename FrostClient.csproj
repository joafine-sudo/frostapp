<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
  <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>FrostClient</AssemblyName>
    <RootNamespace>FrostClient</RootNamespace>
    <Version>1.0.13</Version>
<AssemblyVersion>1.0.13.0</AssemblyVersion>
<FileVersion>1.0.13.0</FileVersion>
<InformationalVersion>1.0.13</InformationalVersion>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CmlLib.Core" Version="4.0.6" />
    <PackageReference Include="CmlLib.Core.Auth.Microsoft" Version="3.3.1" />
    <PackageReference Include="CmlLib.Core.Installer.Forge" Version="2.0.0" />
    <PackageReference Include="DiscordRichPresence" Version="1.6.1.70" />
  </ItemGroup>

  <ItemGroup>
    <!-- This legacy duplicate has the same types as MainWindow.xaml.cs. -->
    <Compile Remove="MainWindow_xaml.cs" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="icon.ico" Condition="Exists('icon.ico')" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="default.png" Condition="Exists('default.png')" />
    <Resource Include="iceland.jpg" Condition="Exists('iceland.jpg')" />
    <Resource Include="house.jpg" Condition="Exists('house.jpg')" />
    <Resource Include="fox.jpg" Condition="Exists('fox.jpg')" />
    <Resource Include="foxcamp.jpg" Condition="Exists('foxcamp.jpg')" />
    <Resource Include="minecraftsteve.jpg" Condition="Exists('minecraftsteve.jpg')" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="default_version\frost client\frost client.json" LogicalName="FrostBundle.json" Condition="Exists('default_version\frost client\frost client.json')" />
    <EmbeddedResource Include="default_version\frost client\frost client.jar" LogicalName="FrostBundle.jar" Condition="Exists('default_version\frost client\frost client.jar')" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="default_version\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

</Project>