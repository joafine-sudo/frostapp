<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>FrostClient</AssemblyName>
    <RootNamespace>FrostClient</RootNamespace>
    <Version>1.0.0</Version>
    <ApplicationIcon>icon.ico</ApplicationIcon>
  </PropertyGroup>

  <!-- Publicação single-file para Windows x64 em Release. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CmlLib.Core" Version="4.0.6" />
    <PackageReference Include="CmlLib.Core.Auth.Microsoft" Version="3.3.1" />
    <PackageReference Include="CmlLib.Core.Installer.Forge" Version="2.0.0" />
    <PackageReference Include="DiscordRichPresence" Version="1.6.1.70" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="icon.ico" Condition="Exists('icon.ico')" />
  </ItemGroup>

  <!-- Fundos do launcher: embutidos dentro do .exe. -->
  <ItemGroup>
    <Resource Include="default.png" Condition="Exists('default.png')" />
    <Resource Include="iceland.jpg" Condition="Exists('iceland.jpg')" />
    <Resource Include="house.jpg"   Condition="Exists('house.jpg')" />
    <Resource Include="fox.jpg"     Condition="Exists('fox.jpg')" />
  </ItemGroup>

  <!-- Versao "frost client" embutida no .exe: assim so e preciso distribuir o FrostClient.exe. -->
  <ItemGroup>
    <EmbeddedResource Include="default_version\frost client\frost client.json" LogicalName="FrostBundle.json" Condition="Exists('default_version\frost client\frost client.json')" />
    <EmbeddedResource Include="default_version\frost client\frost client.jar"  LogicalName="FrostBundle.jar"  Condition="Exists('default_version\frost client\frost client.jar')" />
  </ItemGroup>

  <!-- Keep the custom version files beside the launcher, not embedded in the EXE. -->
  <ItemGroup>
    <Content Include="default_version\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

</Project>