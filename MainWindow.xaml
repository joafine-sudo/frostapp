        <!-- ================= TOOLTIP ================= -->
        <Style TargetType="{x:Type ToolTip}">
            <Setter Property="Background" Value="#0C1018"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#2A3345"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="HasDropShadow" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ToolTip}">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}"
                                              TextElement.FontSize="{TemplateBinding FontSize}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ================= SCROLLBAR ================= -->
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="6"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border Background="#3A4560" CornerRadius="3" Margin="1"/>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ================= TEXTO ================= -->
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
            <Setter Property="Margin" Value="0,0,0,7"/>
        </Style>
        <Style x:Key="RowTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style x:Key="RowDesc" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
            <Setter Property="Margin" Value="0,3,0,10"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <!-- ================= PAINÉIS ================= -->
        <Style x:Key="Panel" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Surface}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="18"/>
            <Setter Property="Padding" Value="24"/>
        </Style>
        <Style x:Key="VersionCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Surface2}"/>
            <Setter Property="BorderBrush" Value="{StaticResource EdgeRaised}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <!-- Item partilhado pelas 3 categorias de versões (Frost Client / Vanilla / Custom) -->
        <!-- ================= TEXTBOX (afundada) ================= -->
        <Style x:Key="TB" TargetType="TextBox">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="CaretBrush" Value="White"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd" Background="{StaticResource Field}"
                                BorderBrush="{StaticResource EdgeInset}"
                                BorderThickness="1.5" CornerRadius="10">
                            <ScrollViewer x:Name="PART_ContentHost" Padding="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#5CC8FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ================= COMBOBOX (afundada) ================= -->
        <Style x:Key="CBI" TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="12,9"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}" CornerRadius="8" Margin="4,1">
                            <ContentPresenter TextElement.Foreground="White"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#263047"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2B8FD1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CB" TargetType="ComboBox">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="MinHeight" Value="38"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource CBI}"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Focusable="False" ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Bd" Background="#0C1018"
                                                BorderBrush="{StaticResource EdgeInset}"
                                                BorderThickness="1.5" CornerRadius="10">
                                            <Grid>
                                                <Border HorizontalAlignment="Right" Width="34" Margin="0,3,3,3"
                                                        CornerRadius="7" Background="#141B27"/>
                                                <Path HorizontalAlignment="Right" VerticalAlignment="Center"
                                                      Margin="0,0,13,0" Fill="#8B95A7" Data="M0,0 L4,4 L8,0 Z"/>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="BorderBrush" Value="#5CC8FF"/>
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Bd" Property="BorderBrush" Value="#5CC8FF"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              Margin="14,0,40,0" VerticalAlignment="Center"
                                              TextElement.Foreground="White"/>
                            <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Top"
                                   AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
                                <Grid Width="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                      MaxHeight="260" SnapsToDevicePixels="True">
                                    <Border Background="#F2101621" BorderBrush="#2A3345" BorderThickness="1"
                                            CornerRadius="12" Margin="0,0,0,6">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,4">
                                            <StackPanel IsItemsHost="True"
                                                        KeyboardNavigation.DirectionalNavigation="Contained"/>
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ================= BOTÕES "TECLA" (realistas, com relevo) ================= -->

        <!-- JOGAR: tecla grande azul-gelo, com brilho e brilho exterior -->
        <Style x:Key="BtnPlay" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="Root">
                            <Border x:Name="Glow" Margin="-8,-8,-8,-2" CornerRadius="24" Background="#305CC8FF"
                                    Opacity="0.35" IsHitTestVisible="False"/>
                            <Border x:Name="Base" CornerRadius="16" Background="#174F82">
                                <Border.Effect>
                                    <DropShadowEffect Color="#3BA7F0" BlurRadius="24" ShadowDepth="0" Opacity="0.35"/>
                                </Border.Effect>
                            </Border>
                            <Border x:Name="Face" CornerRadius="16" Margin="0,0,0,6"
                                    BorderThickness="1.5" BorderBrush="#9BE3FF">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#86DEFF" Offset="0"/>
                                        <GradientStop Color="#47ADF2" Offset="0.55"/>
                                        <GradientStop Color="#2C8BDB" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <Border CornerRadius="14,14,0,0" Background="{StaticResource Gloss}"
                                            IsHitTestVisible="False" Margin="2,2,2,0"/>
                                    <ContentPresenter Grid.RowSpan="2" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                <BeginStoryboard>
                                    <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                        <DoubleAnimation Storyboard.TargetName="Glow" Storyboard.TargetProperty="Opacity"
                                                         From="0.2" To="0.9" Duration="0:0:1.7"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Face" Property="BorderBrush" Value="White"/>
                                <Setter TargetName="Base" Property="Background" Value="#1E6AAE"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Face" Property="Margin" Value="0,4,0,2"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Primário (instalar, login Microsoft, guardar) -->
        <Style x:Key="BtnPrimary" TargetType="Button">
            <Setter Property="Foreground" Value="#06223A"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="Root">
                            <Border x:Name="Base" CornerRadius="10" Background="#174F82"/>
                            <Border x:Name="Face" CornerRadius="10" Margin="0,0,0,3"
                                    BorderThickness="1" BorderBrush="#9BE3FF" Padding="{TemplateBinding Padding}">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#7ED9FF" Offset="0"/>
                                        <GradientStop Color="#3FA4EE" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Face" Property="BorderBrush" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Face" Property="Margin" Value="0,2,0,1"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Secundário (tecla cinzenta) -->
        <Style x:Key="BtnSecondary" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border CornerRadius="10" Background="#0A0E15"/>
                            <Border x:Name="Face" CornerRadius="10" Margin="0,0,0,3"
                                    BorderThickness="1" BorderBrush="{StaticResource EdgeRaised}"
                                    Padding="{TemplateBinding Padding}">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#2F3A52" Offset="0"/>
                                        <GradientStop Color="#1D2536" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Face" Property="BorderBrush" Value="#5CC8FF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Face" Property="Margin" Value="0,2,0,1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Links de navegação (topo) — texto simples, sem fundo em caixa -->
        <Style x:Key="NavLink" TargetType="Button">
            <Setter Property="Foreground" Value="#B9C6E0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Margin" Value="8,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent"
                                BorderBrush="Transparent" BorderThickness="0,0,0,2"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#5CC8FF"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="Tag" Value="Active">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#A9C8FF"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Discord -->
        <Style x:Key="BtnDiscord" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border CornerRadius="10" Background="#2B33A8"/>
                            <Border x:Name="Face" CornerRadius="10" Margin="0,0,0,3"
                                    BorderThickness="1" BorderBrush="#8E98FF" Padding="{TemplateBinding Padding}">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#7480FF" Offset="0"/>
                                        <GradientStop Color="#4753DF" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Face" Property="BorderBrush" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Face" Property="Margin" Value="0,2,0,1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Barra de título (min / fechar) — o ícone vem do Tag -->
        <Style x:Key="BtnChrome" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="8">
                            <Path Data="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
                                  Stroke="{TemplateBinding Foreground}" StrokeThickness="1.8"
                                  Width="12" Height="12" Stretch="Uniform"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#33FFFFFF"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Tecla quadrada com ícone (definições / versões) -->
        <Style x:Key="BtnSquare" TargetType="Button">
            <Setter Property="Width" Value="48"/>
            <Setter Property="Height" Value="48"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border CornerRadius="13" Background="#080B11"/>
                            <Border x:Name="Face" CornerRadius="13" Margin="0,0,0,4"
                                    BorderThickness="1" BorderBrush="{StaticResource EdgeRaised}">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#33405C" Offset="0"/>
                                        <GradientStop Color="#1B2334" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Path x:Name="Ic" Data="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
                                      Fill="#C3CCDE" Width="20" Height="20" Stretch="Uniform"/>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Face" Property="BorderBrush" Value="#5CC8FF"/>
                                <Setter TargetName="Ic" Property="Fill" Value="#5CC8FF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Face" Property="Margin" Value="0,3,0,1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Lixo -->
        <Style x:Key="BtnTrash" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="8" Width="32" Height="32">
                            <Path Data="{StaticResource IconDelete}" Fill="#F26B6B"
                                  Width="14" Height="14" Stretch="Uniform"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#3A1818"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Lápis -->
        <Style x:Key="BtnEdit" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="8" Width="32" Height="32">
                            <Path x:Name="Ic" Data="{StaticResource IconEdit}" Fill="#8B95A7"
                                  Width="14" Height="14" Stretch="Uniform"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#263047"/>
                                <Setter TargetName="Ic" Property="Fill" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Interruptor realista -->
        <Style x:Key="Toggle" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="Tr" Width="48" Height="26" CornerRadius="13"
                                Background="#141B27" BorderThickness="1.5" BorderBrush="{StaticResource EdgeInset}">
                            <Ellipse x:Name="Kn" Width="20" Height="20"
                                     HorizontalAlignment="Left" Margin="2,0,0,0">
                                <Ellipse.Fill>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#FFFFFF" Offset="0"/>
                                        <GradientStop Color="#B9C4D8" Offset="1"/>
                                    </LinearGradientBrush>
                                </Ellipse.Fill>
                                <Ellipse.Effect>
                                    <DropShadowEffect BlurRadius="4" ShadowDepth="1" Opacity="0.5"/>
                                </Ellipse.Effect>
                            </Ellipse>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Tr" Property="Background" Value="#2B8FD1"/>
                                <Setter TargetName="Kn" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="Kn" Property="Margin" Value="0,0,2,0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Chip (presets JVM) -->
        <Style x:Key="BtnChip" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="#141B27" BorderBrush="{StaticResource EdgeRaised}"
                                BorderThickness="1" CornerRadius="14" Padding="13,5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#5CC8FF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#0C1018"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Compatibilidade -->
        <Style x:Key="HomeTile" TargetType="Button">
            <Setter Property="Width" Value="140"/>
            <Setter Property="Height" Value="84"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="#2A3345" BorderThickness="1" CornerRadius="12" Padding="10,8">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.88"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Atalho da barra lateral -->
        <Style x:Key="SocialIcon" TargetType="Button">
            <Setter Property="Width" Value="38"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Margin" Value="0,3"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="12"
                                BorderThickness="1" BorderBrush="Transparent">
                            <Path x:Name="Ic" Data="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
                                  Fill="White" Opacity="0.6" Width="18" Height="18" Stretch="Uniform"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#22FFFFFF"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#33FFFFFF"/>
                                <Setter TargetName="Ic" Property="Opacity" Value="1"/>
                                <Setter TargetName="Ic" Property="Fill" Value="#5CC8FF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#11000000"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Os DataTemplates ficam no FIM dos recursos: usam StaticResource (BtnSecondary,
             BtnEdit, BtnTrash...) e o WPF nao aceita referencias a recursos definidos mais abaixo. -->
        <!-- Segmented tab (Versions page) -->
        <Style x:Key="SegTab" TargetType="Button">
            <Setter Property="Foreground" Value="#B9C6E0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="18,9"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" BorderBrush="Transparent"
                                BorderThickness="1" CornerRadius="9" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#22FFFFFF"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="Tag" Value="Active">
                                <Setter TargetName="Bd" Property="Background" Value="#2B8FD1"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#7FDAFF"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Version card (Vanilla / Custom): long names wrap instead of being cut off -->
        <DataTemplate x:Key="VersionItemTemplate">
            <Border x:Name="Card" Width="270" MinHeight="156" Margin="0,0,16,16" Padding="16"
                    CornerRadius="14" BorderThickness="1" BorderBrush="#447F9AC2" Background="#B51A2638"
                    ToolTip="{Binding RealId}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid>
                        <Border Width="36" Height="36" CornerRadius="10" Background="#1E8AB8E8" HorizontalAlignment="Left">
                            <TextBlock Text="{Binding Letter}" Foreground="#DDEBFF" FontSize="15" FontWeight="Black"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Border Background="#22FFFFFF" CornerRadius="8" Padding="8,2" Margin="0,0,8,0">
                                <TextBlock Text="{Binding Badge}" FontSize="9" FontWeight="Bold" Foreground="#B9D6FF"/>
                            </Border>
                            <TextBlock x:Name="SelBadge" Text="SELECTED" Visibility="Collapsed"
                                       Foreground="#7DBBFF" FontSize="9" FontWeight="Bold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                    <StackPanel Grid.Row="1" VerticalAlignment="Bottom" Margin="0,10,0,10">
                        <TextBlock Text="{Binding DisplayName}" Foreground="White" FontSize="15" FontWeight="Bold"
                                   TextWrapping="Wrap" MaxHeight="42"/>
                        <TextBlock Text="{Binding RealId}" Foreground="{StaticResource TextMuted}" FontSize="10"
                                   Margin="0,4,0,0" TextWrapping="Wrap" MaxHeight="28"/>
                    </StackPanel>
                    <StackPanel Grid.Row="2" Orientation="Horizontal">
                        <Button Tag="{Binding RealId}" Content="{Binding [select], Source={x:Static loc:Loc.Instance}}"
                                Style="{StaticResource BtnSecondary}" Padding="14,6" FontSize="10" Margin="0,0,8,0"
                                Click="SelectVersion_Click"/>
                        <Button Tag="{Binding RealId}" Style="{StaticResource BtnEdit}"
                                ToolTip="{Binding [rename], Source={x:Static loc:Loc.Instance}}"
                                Click="RenameVersionFromList_Click"/>
                        <Button Tag="{Binding RealId}" Style="{StaticResource BtnTrash}"
                                ToolTip="{Binding [delete], Source={x:Static loc:Loc.Instance}}"
                                Click="DeleteVersion_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <Trigger SourceName="Card" Property="IsMouseOver" Value="True">
                    <Setter TargetName="Card" Property="BorderBrush" Value="#A9D4FF"/>
                </Trigger>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter TargetName="Card" Property="BorderBrush" Value="#7DBBFF"/>
                    <Setter TargetName="Card" Property="BorderThickness" Value="2"/>
                    <Setter TargetName="Card" Property="Background" Value="#D0264267"/>
                    <Setter TargetName="SelBadge" Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Frost Client's own version: shows the base (Minecraft 1.8.9), no delete button -->
        <DataTemplate x:Key="FrostClientItemTemplate">
            <Border x:Name="Card" Width="270" MinHeight="156" Margin="0,0,16,16" Padding="16"
                    CornerRadius="14" BorderThickness="1" BorderBrush="#447F9AC2" Background="#B51A2638"
                    ToolTip="{Binding RealId}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid>
                        <Border Width="36" Height="36" CornerRadius="10" HorizontalAlignment="Left"
                                BorderThickness="1" BorderBrush="#7FDAFF">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#5CBFF5" Offset="0"/>
                                    <GradientStop Color="#2B8FD1" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <TextBlock Text="{Binding Letter}" Foreground="White" FontSize="15" FontWeight="Black"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock x:Name="SelBadge" Text="SELECTED" Visibility="Collapsed"
                                   Foreground="#7DBBFF" FontSize="9" FontWeight="Bold"
                                   HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                    <StackPanel Grid.Row="1" VerticalAlignment="Bottom" Margin="0,10,0,10">
                        <TextBlock Text="{Binding DisplayName}" Foreground="White" FontSize="15" FontWeight="Bold"
                                   TextWrapping="Wrap" MaxHeight="42"/>
                        <TextBlock Text="Minecraft 1.8.9" Foreground="{StaticResource TextMuted}" FontSize="10"
                                   Margin="0,4,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Row="2" Orientation="Horizontal">
                        <Button Tag="{Binding RealId}" Content="{Binding [select], Source={x:Static loc:Loc.Instance}}"
                                Style="{StaticResource BtnSecondary}" Padding="14,6" FontSize="10" Margin="0,0,8,0"
                                Click="SelectVersion_Click"/>
                        <Button Tag="{Binding RealId}" Style="{StaticResource BtnEdit}"
                                ToolTip="{Binding [rename], Source={x:Static loc:Loc.Instance}}"
                                Click="RenameVersionFromList_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <Trigger SourceName="Card" Property="IsMouseOver" Value="True">
                    <Setter TargetName="Card" Property="BorderBrush" Value="#A9D4FF"/>
                </Trigger>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter TargetName="Card" Property="BorderBrush" Value="#7DBBFF"/>
                    <Setter TargetName="Card" Property="BorderThickness" Value="2"/>
                    <Setter TargetName="Card" Property="Background" Value="#D0264267"/>
                    <Setter TargetName="SelBadge" Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <!-- ====================== ROOT ====================== -->
    <Border x:Name="RootBorder" CornerRadius="14" Background="#0B1220" BorderBrush="#2A3345" BorderThickness="1" ClipToBounds="True">
        <Grid>
            <!-- Fundo por defeito (gelo) -->
            <Rectangle x:Name="GreenBg">
                <Rectangle.Fill>
                    <RadialGradientBrush Center="0.5,0.35" RadiusX="0.9" RadiusY="1">
                        <GradientStop Color="#2E6FA8" Offset="0"/>
                        <GradientStop Color="#16355A" Offset="0.55"/>
                        <GradientStop Color="#0B1220" Offset="1"/>
                    </RadialGradientBrush>
                </Rectangle.Fill>
            </Rectangle>

            <!-- Fundo com imagem -->
            <Rectangle x:Name="WallpaperRect" Visibility="Collapsed">
                <Rectangle.Fill>
                    <ImageBrush x:Name="BackgroundImageBrush" Stretch="UniformToFill"/>
                </Rectangle.Fill>
            </Rectangle>
            <Rectangle x:Name="WallpaperShade" Visibility="Collapsed">
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#22000000" Offset="0"/>
                        <GradientStop Color="#00000000" Offset="0.5"/>
                        <GradientStop Color="#77000000" Offset="1"/>
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>

            <Rectangle IsHitTestVisible="False">
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#33000000" Offset="0"/>
                        <GradientStop Color="#00000000" Offset="0.4"/>
                        <GradientStop Color="#1A000000" Offset="1"/>
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>

            <!-- =================== ECRÃ ÚNICO =================== -->
            <Grid x:Name="MainLauncherUI">
                <Grid.RowDefinitions>
                    <RowDefinition Height="76"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Top navigation -->
                <Grid Grid.Row="0" MouseLeftButtonDown="TopBar_MouseDown">
                    <Border Background="#990A111D"/>
                    <Border Height="1" VerticalAlignment="Bottom" Background="#22FFFFFF"/>
                    <Grid Margin="34,0,22,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="FROST CLIENT" FontSize="25" FontWeight="Black"
                                   Foreground="#EAF1FF" VerticalAlignment="Center"/>

                        <StackPanel Grid.Column="1" Orientation="Horizontal"
                                    HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Button x:Name="NavHomeButton" Content="Home" Tag="Active"
                                    Style="{StaticResource NavLink}" Click="ShowHome_Click"/>
                            <Button x:Name="NavVersionsButton" Content="Versions"
                                    Style="{StaticResource NavLink}" Click="OpenVersions_Click"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Grid Margin="0,0,8,0">
                                <Button Style="{StaticResource SocialIcon}" Tag="{StaticResource IconUpdate}"
                                        Click="OpenUpdates_Click" ToolTip="Updates" Margin="0"/>
                                <Ellipse x:Name="UpdateDot" Width="9" Height="9" Fill="#5CC8FF"
                                         Stroke="#0A111D" StrokeThickness="1.5"
                                         HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,6,6,0"
                                         Visibility="Collapsed" IsHitTestVisible="False"/>
                            </Grid>
                            <Button Style="{StaticResource SocialIcon}" Tag="{StaticResource IconSettings}"
                                    Click="OpenSettings_Click" ToolTip="Settings" Margin="0,0,8,0"/>
                            <Button Cursor="Hand" Focusable="False" Click="OpenAccount_Click"
                                    Background="Transparent" BorderThickness="0" Padding="4">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Width="34" Height="34" CornerRadius="9" Background="#172235"
                                            BorderBrush="#53647F" BorderThickness="1" ClipToBounds="True">
                                        <Grid>
                                            <TextBlock Text="❄" Foreground="#8FA4C8" FontSize="16"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            <Image x:Name="TopPlayerAvatar" Stretch="UniformToFill"
                                                   RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                                        </Grid>
                                    </Border>
                                    <StackPanel Margin="9,0,10,0" VerticalAlignment="Center" MaxWidth="130">
                                        <TextBlock x:Name="TopPlayerName"
                                                   Text="{Binding [not_logged_in], Source={x:Static loc:Loc.Instance}}"
                                                   Foreground="White" FontSize="12" FontWeight="Bold"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock x:Name="TopPlayerType" Text="" Foreground="#9CB9EA" FontSize="9"/>
                                    </StackPanel>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource BtnChrome}" Tag="{StaticResource IconMin}" Click="Minimize_Click"/>
                            <Button Style="{StaticResource BtnChrome}" Tag="{StaticResource IconMax}" Click="Maximize_Click"/>
                            <Button Style="{StaticResource BtnChrome}" Tag="{StaticResource IconClose}" Click="Close_Click"/>
                        </StackPanel>
                    </Grid>
                </Grid>

                <!-- Main home content -->
                <Grid x:Name="HomePage" Grid.Row="1" Margin="38,20,38,22">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" MinHeight="300"/>
                        <RowDefinition Height="190"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="250"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Left"
                                    MaxWidth="620" Margin="0,0,24,18">
                            <TextBlock Text="FROST CLIENT  /  HOME" Foreground="#B6C7E4"
                                       FontSize="11" FontWeight="Bold" Margin="0,0,0,16"/>
                            <TextBlock x:Name="HeroVersionTitle" Text="Frost Client"
                                       FontSize="48" FontWeight="Black" Foreground="#F1F5FF"
                                       TextWrapping="Wrap" Margin="0,0,0,8"/>
                            <TextBlock Text="Ready for your next adventure?" Foreground="#D4DDF0"
                                       FontSize="15" FontWeight="SemiBold" Margin="0,0,0,24"/>
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="PlayButton" Style="{StaticResource BtnPlay}"
                                        Width="178" Height="58" Click="Play_Click">
                                    <TextBlock x:Name="PlayText"
                                               Text="{Binding [play], Source={x:Static loc:Loc.Instance}}"
                                               FontSize="20" FontWeight="Black" Foreground="#06223A"
                                               Margin="0,0,0,4"/>
                                </Button>
                                <Button Content="Manage versions" Style="{StaticResource BtnSecondary}"
                                        Margin="14,0,0,0" Padding="18,12" Click="OpenVersions_Click"/>
                            </StackPanel>
                            <TextBlock x:Name="StatusText" Text="" Foreground="#B8C2D6"
                                       FontSize="10" Margin="0,18,0,0" TextWrapping="Wrap"/>
                        </StackPanel>

                        <StackPanel x:Name="RightColumn" Grid.Column="1" Opacity="0"
                                    VerticalAlignment="Top" HorizontalAlignment="Right" Width="230">
                            <StackPanel.RenderTransform><TranslateTransform/></StackPanel.RenderTransform>
                            <Border Background="#B8172233" BorderBrush="#55FFFFFF"
                                    BorderThickness="1" CornerRadius="16" Padding="15" Margin="0,0,0,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="1"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock x:Name="LauncherCountText" Text="--" Foreground="White"
                                                   FontSize="22" FontWeight="Black"/>
                                        <TextBlock Text="IN LAUNCHER" Foreground="#AAB8CE" FontSize="9" FontWeight="Bold"/>
                                    </StackPanel>
                                    <Border Grid.Column="1" Background="#44FFFFFF" Margin="0,4"/>
                                    <StackPanel Grid.Column="2" Margin="12,0,0,0">
                                        <TextBlock x:Name="GameCountText" Text="--" Foreground="#8BCBFF"
                                                   FontSize="22" FontWeight="Black"/>
                                        <TextBlock Text="IN GAME" Foreground="#AAB8CE" FontSize="9" FontWeight="Bold"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <Border Background="{StaticResource DiscordBg}" BorderBrush="#55FFFFFF"
                                    BorderThickness="1" CornerRadius="16" Padding="15">
                                <StackPanel>
                                    <TextBlock Text="{Binding [join_discord], Source={x:Static loc:Loc.Instance}}"
                                               FontSize="14" FontWeight="Bold" Foreground="White" TextWrapping="Wrap"/>
                                    <Button Style="{StaticResource BtnDiscord}" HorizontalAlignment="Left"
                                            Margin="0,10,0,0" Click="Discord_Click"
                                            ToolTip="{Binding [join_discord_tip], Source={x:Static loc:Loc.Instance}}">
                                        <TextBlock Text="Discord" FontSize="11"/>
                                    </Button>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Retained named elements for existing entrance animations and compatibility. -->
                        <Border x:Name="StatsCard" Visibility="Collapsed"/>
                        <Border x:Name="SideRail" Visibility="Collapsed" Opacity="0">
                            <Border.RenderTransform><TranslateTransform/></Border.RenderTransform>
                        </Border>
                    </Grid>

                    <!-- Installed-version gallery -->
                    <Grid x:Name="DockPanel" Grid.Row="1" Opacity="0">
                        <Grid.RenderTransform><TranslateTransform/></Grid.RenderTransform>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid Margin="0,0,0,10">
                            <TextBlock Text="YOUR VERSIONS" Foreground="#DCE7FA" FontSize="11"
                                       FontWeight="Bold" VerticalAlignment="Center"/>
                            <Button Content="View all" Style="{StaticResource BtnSecondary}"
                                    HorizontalAlignment="Right" Padding="12,5" Click="OpenVersions_Click"/>
                        </Grid>
                        <ListBox x:Name="VersionGallery" Grid.Row="1"
                                 ItemsSource="{Binding ItemsSource, ElementName=VersionList}"
                                 SelectedItem="{Binding SelectedItem, ElementName=VersionBox, Mode=TwoWay}"
                                 Background="Transparent" BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                 ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                 HorizontalContentAlignment="Stretch">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Margin" Value="0,0,14,0"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="Card" Width="250" Height="132"
                                                        Background="#B51A2638" BorderBrush="#447F9AC2"
                                                        BorderThickness="1" CornerRadius="14" Padding="15">
                                                    <Grid>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="*"/>
                                                            <RowDefinition Height="Auto"/>
                                                        </Grid.RowDefinitions>
                                                        <Border Background="#1E8AB8E8" CornerRadius="9"
                                                                HorizontalAlignment="Right" Width="34" Height="34">
                                                            <TextBlock Text="{Binding Letter}" Foreground="#DDEBFF"
                                                                       FontSize="14" FontWeight="Black"
                                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                        <StackPanel Grid.Row="1">
                                                            <TextBlock Text="{Binding DisplayName}" Foreground="White"
                                                                       FontSize="16" FontWeight="Bold"
                                                                       TextTrimming="CharacterEllipsis"/>
                                                            <TextBlock Text="{Binding RealId}" Foreground="#AAB8CE"
                                                                       FontSize="10" Margin="0,4,0,0"
                                                                       TextTrimming="CharacterEllipsis"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="Card" Property="BorderBrush" Value="#7DBBFF"/>
                                                        <Setter TargetName="Card" Property="BorderThickness" Value="2"/>
                                                        <Setter TargetName="Card" Property="Background" Value="#D0264267"/>
                                                    </Trigger>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Card" Property="BorderBrush" Value="#A9D4FF"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                        </ListBox>
                    </Grid>
                </Grid>

                <!-- =================== PÁGINA: VERSIONS =================== -->
                <Grid x:Name="VersionsPage" Grid.Row="1" Visibility="Collapsed">
                    <!-- background próprio desta página -->
                    <Rectangle IsHitTestVisible="False">
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#F2081019" Offset="0"/>
                                <GradientStop Color="#F00F1A2C" Offset="0.55"/>
                                <GradientStop Color="#F2070B13" Offset="1"/>
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>
                    <Rectangle IsHitTestVisible="False">
                        <Rectangle.Fill>
                            <RadialGradientBrush Center="0.1,0" RadiusX="0.75" RadiusY="0.9">
                                <GradientStop Color="#552E7DC0" Offset="0"/>
                                <GradientStop Color="#002E7DC0" Offset="1"/>
                            </RadialGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>
                    <Rectangle IsHitTestVisible="False">
                        <Rectangle.Fill>
                            <RadialGradientBrush Center="1,1" RadiusX="0.6" RadiusY="0.7">
                                <GradientStop Color="#334A5CC8" Offset="0"/>
                                <GradientStop Color="#004A5CC8" Offset="1"/>
                            </RadialGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>

                    <Grid Margin="38,26,38,24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="24"/>
                            <ColumnDefinition Width="300"/>
                        </Grid.ColumnDefinitions>

                        <!-- esquerda: separadores + lista -->
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Grid Margin="0,0,0,18">
                                <StackPanel HorizontalAlignment="Left">
                                    <TextBlock Text="FROST CLIENT  /  VERSIONS" Foreground="#B6C7E4"
                                               FontSize="11" FontWeight="Bold" Margin="0,0,0,10"/>
                                    <TextBlock Text="{Binding [nav_versions], Source={x:Static loc:Loc.Instance}}"
                                               FontSize="34" FontWeight="Black" Foreground="#F1F5FF"/>
                                    <TextBlock Text="{Binding [versions_sub], Source={x:Static loc:Loc.Instance}}"
                                               FontSize="12" Foreground="#B8C2D6" Margin="0,6,0,0"/>
                                </StackPanel>
                                <Button Content="{Binding [refresh], Source={x:Static loc:Loc.Instance}}"
                                        Style="{StaticResource BtnSecondary}" Padding="14,8"
                                        HorizontalAlignment="Right" VerticalAlignment="Top"
                                        Click="RefreshVersions_Click"/>
                            </Grid>

                            <!-- Category tabs + search -->
                            <Grid Grid.Row="1" Margin="0,0,0,18">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="230"/>
                                </Grid.ColumnDefinitions>
                                <Border Background="#99080C14" BorderBrush="{StaticResource EdgeInset}"
                                        BorderThickness="1.5" CornerRadius="12" Padding="4">
                                    <StackPanel Orientation="Horizontal">
                                        <Button x:Name="TabFrostButton" Content="Frost Client" Tag="Active"
                                                CommandParameter="frost" Style="{StaticResource SegTab}"
                                                Click="VersionTab_Click"/>
                                        <Button x:Name="TabVanillaButton" Content="Vanilla"
                                                CommandParameter="vanilla" Style="{StaticResource SegTab}"
                                                Click="VersionTab_Click"/>
                                        <Button x:Name="TabCustomButton" Content="Custom"
                                                CommandParameter="custom" Style="{StaticResource SegTab}"
                                                Click="VersionTab_Click"/>
                                    </StackPanel>
                                </Border>
                                <Grid Grid.Column="2" VerticalAlignment="Center">
                                    <TextBox x:Name="VersionSearchBox" Style="{StaticResource TB}" Padding="12,8"
                                             TextChanged="VersionSearch_Changed"/>
                                    <TextBlock x:Name="VersionSearchHint" Text="Search versions..."
                                               Foreground="{StaticResource TextMuted}" FontSize="12"
                                               Margin="14,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
                                </Grid>
                            </Grid>

                            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                                <StackPanel Margin="0,0,12,0">
                                    <!-- Hidden data source: the home gallery (VersionGallery) binds to this ItemsSource. -->
                                    <ItemsControl x:Name="VersionList" Visibility="Collapsed"/>

                                    <ItemsControl x:Name="VersionTabList">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                    </ItemsControl>

                                    <Border x:Name="VersionsEmpty" Visibility="Collapsed" Background="#66101826"
                                            BorderBrush="#2A3345" BorderThickness="1" CornerRadius="14" Padding="30">
                                        <TextBlock x:Name="VersionsEmptyText" Foreground="{StaticResource TextMuted}"
                                                   FontSize="12" TextAlignment="Center" TextWrapping="Wrap"/>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>

                        <!-- direita: instalar nova versão -->
                        <Border Grid.Column="2" VerticalAlignment="Top"
                                Background="#B8172233" BorderBrush="#55FFFFFF"
                                BorderThickness="1" CornerRadius="16" Padding="18">
                            <StackPanel>
                                <TextBlock Text="{Binding [install_new], Source={x:Static loc:Loc.Instance}}"
                                           Foreground="White" FontSize="15" FontWeight="Bold" Margin="0,0,0,14"/>
                                <TextBlock Text="{Binding [mc_version], Source={x:Static loc:Loc.Instance}}"
                                           Style="{StaticResource Label}"/>
                                <ComboBox x:Name="InstallVersionBox" Style="{StaticResource CB}" Margin="0,0,0,14"/>
                                <Button x:Name="InstallButton" Style="{StaticResource BtnPrimary}" Margin="0,0,0,12"
                                        Content="{Binding [download_install], Source={x:Static loc:Loc.Instance}}"
                                        Click="InstallVersion_Click"/>
                                <ProgressBar x:Name="InstallProgress" Height="4" Visibility="Collapsed"
                                             IsIndeterminate="True" Foreground="#5CC8FF" Background="#0C1018"
                                             BorderThickness="0" Margin="0,0,0,10"/>
                                <Border Background="#0A0F17" BorderBrush="{StaticResource EdgeInset}"
                                        BorderThickness="1.5" CornerRadius="10" Padding="12">
                                    <TextBlock x:Name="InstallStatusText" FontSize="10" TextWrapping="Wrap"
                                               Foreground="{StaticResource TextMuted}"
                                               Text="{Binding [waiting_install], Source={x:Static loc:Loc.Instance}}"/>
                                </Border>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>

                <!-- Hidden selector remains the source of truth for launch logic. -->
                <ComboBox x:Name="VersionBox" Visibility="Collapsed"
                          DisplayMemberPath="DisplayName" SelectionChanged="Version_Changed"/>
                <TextBlock x:Name="HomeVersionLabel" Visibility="Collapsed"/>
            </Grid>

            <!-- ====== DEFINIÇÕES ====== -->
            <Grid x:Name="SettingsOverlay" Panel.ZIndex="100" Visibility="Collapsed" Background="#B3000000">
                <Border Style="{StaticResource Panel}" Width="560" MaxHeight="680"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid Margin="0,0,0,16">
                            <TextBlock Text="{Binding [nav_settings], Source={x:Static loc:Loc.Instance}}"
                                       FontSize="20" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                            <Button Style="{StaticResource BtnChrome}" Tag="{StaticResource IconClose}"
                                    HorizontalAlignment="Right" Click="CloseSettings_Click"/>
                        </Grid>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="0,0,12,0">
                                <TextBlock Text="{Binding [language], Source={x:Static loc:Loc.Instance}}" Style="{StaticResource RowTitle}"/>
                                <TextBlock Text="{Binding [language_desc], Source={x:Static loc:Loc.Instance}}" Style="{StaticResource RowDesc}"/>
                                <ComboBox x:Name="LanguageBox" Style="{StaticResource CB}" Margin="0,0,0,22"
                                          SelectionChanged="Language_Changed">
                                    <ComboBoxItem Content="English (UK)" Tag="en-GB"/>
                                    <ComboBoxItem Content="Português" Tag="pt-PT"/>
                                    <ComboBoxItem Content="Español" Tag="es-ES"/>
                                    <ComboBoxItem Content="Français" Tag="fr-FR"/>
                                    <ComboBoxItem Content="Русский" Tag="ru-RU"/>
                                    <ComboBoxItem Content="ไทย" Tag="th-TH"/>
                                </ComboBox>

                                <TextBlock Text="{Binding [ram], Source={x:Static loc:Loc.Instance}}" Style="{StaticResource RowTitle}"/>
                                <TextBlock Text="{Binding [ram_desc], Source={x:Static loc:Loc.Instance}}" Style="{StaticResource RowDesc}"/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,22">
                                    <Slider x:Name="RamSlider" Width="380" Minimum="1" Maximum="16" Value="4"
                                            TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center"
                                            ValueChanged="RamSlider_Changed"/>
                                    <TextBlock x:Name="RamLabel" Text="4 GB" Width="70" Foreground="#5CC8FF"
                                               FontWeight="Bold" FontSize="14" TextAlignment="Right" VerticalAlignment="Center"/>
                                </StackPanel>

                                <TextBlock Text="{Binding [res], Source={x:Static loc:Loc.Instance}}" Style="{StaticResource RowTitle}"/>
                                <TextBlock Text="{Binding [res_desc], Source={x:Static loc:Loc.Instance}}" Style="{StaticResource RowDesc}"/>
                                <ComboBox x:Name="ResolutionBox" Style="{StaticResource CB}" Margin="0,0,0,22"
                                          SelectionChanged="Settings_ComboChanged">
                                    <ComboBoxItem Content="{Binding [res_default], Source={x:Static loc:Loc.Instance}}"/>
                                    <ComboBoxItem Content="1280 × 720"/>
                                    <ComboBoxItem Content="1600 × 900"/>
                                    <ComboBoxItem Content="1920 × 1080"/>
                                </ComboBox>

                                <TextBlock Text="{Binding [on_open], Source={x:Static loc:Loc.Instance}}" Style="{StaticResource RowTitle}"/>
                                <TextBlock Text="{Binding [on_open_desc], Source={x:Static loc:Loc.Instance}}" Style="{StaticResource RowDesc}"/>
                                <ComboBox x:Name="OnLaunchBox" Style="{StaticResource CB}" Margin="0,0,0,22"
                                          SelectionChanged="Settings_ComboChanged">
                                    <ComboBoxItem Content="{Binding [keep_open], Source={x:Static loc:Loc.Instance}}"/>
                                    <ComboBoxItem Content="{Binding [minimize], Source={x:Static loc:Loc.Instance}}"/>
                                </ComboBox>

                                <Grid Margin="0,0,0,22">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Discord Rich Presence" Style="{StaticResource RowTitle}"/>
                                        <TextBlock Text="{Binding [discord_rpc_desc], Source={x:Static loc:Loc.Instance}}"
                                                   Style="{StaticResource RowDesc}" Margin="0,3,0,0"/>
                                    </StackPanel>
                                    <CheckBox x:Name="DiscordToggle" Grid.Column="1" Style="{StaticResource Toggle}"
                                              IsChecked="True" VerticalAlignment="Center"
                                              Checked="DiscordToggle_Changed" Unchecked="DiscordToggle_Changed"/>
                                </Grid>

                                <TextBlock Text="{Binding [java_exe], Source={x:Static loc:Loc.Instance}}" Style="{StaticResource RowTitle}"/>
                                <TextBlock Text="{Binding [java_exe_desc], Source={x:Static loc:Loc.Instance}}" Style="{StaticResource RowDesc}"/>
                                <Grid Margin="0,0,0,22">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="JavaPathBox" Style="{StaticResource TB}" Margin="0,0,8,0"
                                             TextChanged="Settings_TextChanged"/>
                                    <Button Grid.Column="1" Content="{Binding [browse], Source={x:Static loc:Loc.Instance}}"
                                            Style="{StaticResource BtnSecondary}" Click="BrowseJava_Click"/>
                                </Grid>

                                <TextBlock Text="{Binding [jvm_args], Source={x:Static loc:Loc.Instance}}" Style="{StaticResource RowTitle}"/>
                                <TextBlock Text="{Binding [jvm_args_desc], Source={x:Static loc:Loc.Instance}}" Style="{StaticResource RowDesc}"/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <Button Content="{Binding [preset_balanced], Source={x:Static loc:Loc.Instance}}" Tag="Balanced" Style="{StaticResource BtnChip}" Click="JvmPreset_Click"/>
                                    <Button Content="{Binding [preset_perf], Source={x:Static loc:Loc.Instance}}" Tag="Performance" Style="{StaticResource BtnChip}" Click="JvmPreset_Click"/>
                                    <Button Content="{Binding [preset_maxfps], Source={x:Static loc:Loc.Instance}}" Tag="MaxFps" Style="{StaticResource BtnChip}" Click="JvmPreset_Click"/>
                                    <Button Content="{Binding [preset_clear], Source={x:Static loc:Loc.Instance}}" Tag="Clear" Style="{StaticResource BtnChip}" Click="JvmPreset_Click"/>
                                </StackPanel>
                                <TextBox x:Name="JavaArgumentsBox" Style="{StaticResource TB}" AcceptsReturn="True"
                                         TextWrapping="Wrap" MinHeight="70" VerticalContentAlignment="Top"
                                         VerticalScrollBarVisibility="Auto" TextChanged="Settings_TextChanged"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>

            <!-- ====== UPDATES ====== -->
            <Grid x:Name="UpdateOverlay" Panel.ZIndex="120" Visibility="Collapsed" Background="#B3000000">
                <Border Style="{StaticResource Panel}" Width="460" Padding="26"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
                    <StackPanel>
                        <Grid Margin="0,0,0,6">
                            <TextBlock Text="Updates" FontSize="20" FontWeight="Bold" Foreground="White"
                                       VerticalAlignment="Center"/>
                            <Button Style="{StaticResource BtnChrome}" Tag="{StaticResource IconClose}"
                                    HorizontalAlignment="Right" Click="CloseUpdates_Click"/>
                        </Grid>
                        <TextBlock Text="Check if a new Frost Client build is available on GitHub."
                                   Style="{StaticResource RowDesc}" Margin="0,0,0,16"/>
                        <Border Background="#0A0F17" BorderBrush="{StaticResource EdgeInset}"
                                BorderThickness="1.5" CornerRadius="10" Padding="16" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock x:Name="UpdateTitleText" Text="You're up to date" Foreground="White"
                                           FontSize="14" FontWeight="SemiBold"/>
                                <TextBlock x:Name="UpdateStatusText" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0"
                                           Foreground="{StaticResource TextMuted}"
                                           Text="You're on the latest version."/>
                            </StackPanel>
                        </Border>
                        <ProgressBar x:Name="UpdateProgress" Height="4" Visibility="Collapsed" IsIndeterminate="True"
                                     Foreground="#5CC8FF" Background="#0C1018" BorderThickness="0" Margin="0,0,0,12"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,0,0">
                            <Button x:Name="UpdateLaterButton" Content="Later" Style="{StaticResource BtnSecondary}"
                                    MinWidth="90" Margin="0,0,10,0" Click="CloseUpdates_Click"/>
                            <Button x:Name="CheckUpdateButton" Content="Check for updates"
                                    Style="{StaticResource BtnSecondary}" Margin="0,0,10,0" Click="CheckForUpdate_Click"/>
                            <Button x:Name="DownloadUpdateButton" Content="Update now"
                                    Style="{StaticResource BtnPrimary}" MinWidth="110"
                                    Visibility="Collapsed" Click="DownloadUpdate_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ====== RENOMEAR VERSÃO ====== -->
            <Grid x:Name="RenameOverlay" Panel.ZIndex="240" Visibility="Collapsed" Background="#B3000000">
                <Border Style="{StaticResource Panel}" Width="440" Padding="26"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
                    <StackPanel>
                        <TextBlock x:Name="RenameTitle" Text="{Binding [rename_version], Source={x:Static loc:Loc.Instance}}"
                                   Foreground="White" FontSize="18" FontWeight="Bold" Margin="0,0,0,6"/>
                        <TextBlock x:Name="RenameSubText" Text="{Binding [rename_desc], Source={x:Static loc:Loc.Instance}}"
                                   Foreground="{StaticResource TextMuted}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,18"/>
                        <TextBlock x:Name="RenameLabel" Text="{Binding [display_name], Source={x:Static loc:Loc.Instance}}"
                                   Style="{StaticResource Label}"/>
                        <TextBox x:Name="RenameBox" Style="{StaticResource TB}" MaxLength="50" Margin="0,0,0,20"
                                 KeyDown="RenameBox_KeyDown"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="{Binding [cancel], Source={x:Static loc:Loc.Instance}}"
                                    Style="{StaticResource BtnSecondary}" Margin="0,0,10,0" Click="RenameCancel_Click"/>
                            <Button Content="{Binding [save], Source={x:Static loc:Loc.Instance}}"
                                    Style="{StaticResource BtnPrimary}" MinWidth="90" Click="RenameSave_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ====== CONTAS ====== -->
            <Grid x:Name="AccountOverlay" Panel.ZIndex="110" Visibility="Collapsed" Background="#B3000000">
                <Border Style="{StaticResource Panel}" Width="520" MaxHeight="600"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="0,0,8,0">
                            <Grid Margin="0,0,0,16">
                                <TextBlock Text="{Binding [nav_accounts], Source={x:Static loc:Loc.Instance}}"
                                           FontSize="20" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                                <Button Style="{StaticResource BtnChrome}" Tag="{StaticResource IconClose}"
                                        HorizontalAlignment="Right" Click="CloseAccount_Click"/>
                            </Grid>

                            <TextBlock Text="{Binding [saved_accounts], Source={x:Static loc:Loc.Instance}}" Style="{StaticResource Label}"/>
                            <ItemsControl x:Name="AccountsListBox" Margin="0,0,0,12">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource VersionCard}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Width="38" Height="38" CornerRadius="9" Background="#0C1018"
                                                        BorderThickness="1.5" BorderBrush="{StaticResource EdgeInset}"
                                                        ClipToBounds="True" Margin="0,0,12,0">
                                                    <Image Source="{Binding AvatarUrl}" Stretch="UniformToFill"
                                                           RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                                                </Border>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding DisplayName}" Foreground="White"
                                                               FontWeight="SemiBold" FontSize="13"/>
                                                    <TextBlock Text="{Binding TypeLabel}" Foreground="#5CC8FF"
                                                               FontSize="10" Margin="0,2,0,0"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Button Tag="{Binding Id}"
                                                            Content="{Binding [select], Source={x:Static loc:Loc.Instance}}"
                                                            Style="{StaticResource BtnSecondary}" Padding="12,6"
                                                            FontSize="10" Margin="0,0,6,0" Click="SelectAccount_Click"/>
                                                    <Button Tag="{Binding Id}" Style="{StaticResource BtnTrash}"
                                                            ToolTip="{Binding [remove_account_tip], Source={x:Static loc:Loc.Instance}}"
                                                            Click="DeleteAccount_Click"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="{Binding [add_offline_title], Source={x:Static loc:Loc.Instance}}" Style="{StaticResource Label}" Margin="0,6,0,4"/>
                            <TextBlock Text="{Binding [add_offline_desc], Source={x:Static loc:Loc.Instance}}" Style="{StaticResource RowDesc}"/>
                            <Grid Margin="0,0,0,18">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="NewAccountNameBox" Style="{StaticResource TB}" MaxLength="16" Margin="0,0,8,0"/>
                                <Button Grid.Column="1" Content="{Binding [add_offline_btn], Source={x:Static loc:Loc.Instance}}"
                                        Style="{StaticResource BtnSecondary}" Click="AddOfflineAccountConfirm_Click"/>
                            </Grid>

                            <TextBlock Text="{Binding [ms_account], Source={x:Static loc:Loc.Instance}}" Style="{StaticResource Label}" Margin="0,0,0,4"/>
                            <TextBlock Text="{Binding [ms_desc], Source={x:Static loc:Loc.Instance}}" Style="{StaticResource RowDesc}"/>
                            <Button x:Name="MicrosoftLoginButton"
                                    Content="{Binding [ms_signin], Source={x:Static loc:Loc.Instance}}"
                                    Style="{StaticResource BtnPrimary}" HorizontalAlignment="Stretch"
                                    Click="AddMicrosoftAccountConfirm_Click"/>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>

            <!-- ====== CONFIRMAR (apagar) ====== -->
            <Grid x:Name="ConfirmOverlay" Panel.ZIndex="250" Visibility="Collapsed" Background="#B3000000">
                <Border Style="{StaticResource Panel}" Width="420" Padding="26"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
                    <StackPanel>
                        <TextBlock x:Name="ConfirmTitle" Text="{Binding [confirm_action], Source={x:Static loc:Loc.Instance}}"
                                   Foreground="White" FontSize="19" FontWeight="Bold" Margin="0,0,0,8"/>
                        <TextBlock x:Name="ConfirmMessage" Text="{Binding [are_you_sure], Source={x:Static loc:Loc.Instance}}"
                                   Foreground="{StaticResource TextMuted}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,22"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="{Binding [cancel], Source={x:Static loc:Loc.Instance}}"
                                    Style="{StaticResource BtnSecondary}" MinWidth="100" Margin="0,0,10,0" Click="ConfirmCancel_Click"/>
                            <Button Content="{Binding [delete_btn], Source={x:Static loc:Loc.Instance}}"
                                    Style="{StaticResource BtnPrimary}" MinWidth="100" Click="ConfirmAccept_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ====== RECURSOS (download inicial) ====== -->
            <Grid x:Name="ResourcesOverlay" Panel.ZIndex="300" Visibility="Collapsed" Background="#E6000000">
                <Border Style="{StaticResource Panel}" Width="460" Padding="28"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
                    <StackPanel>
                        <TextBlock Text="{Binding [resources_title], Source={x:Static loc:Loc.Instance}}"
                                   Foreground="White" FontSize="19" FontWeight="Bold" Margin="0,0,0,6"/>
                        <TextBlock x:Name="ResourcesStatusText" Text="{Binding [resources_checking], Source={x:Static loc:Loc.Instance}}"
                                   Foreground="{StaticResource TextMuted}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,18"/>
                        <ProgressBar x:Name="ResourcesProgress" Height="6" Minimum="0" Maximum="100" Value="0"
                                     Foreground="#5CC8FF" Background="#0C1018" BorderThickness="0" Margin="0,0,0,8"/>
                        <TextBlock x:Name="ResourcesPercentText" Text="0%" Foreground="{StaticResource TextMuted}"
                                   FontSize="11" HorizontalAlignment="Right" Margin="0,0,0,6"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                            <Button x:Name="ResourcesSkipButton" Content="{Binding [skip], Source={x:Static loc:Loc.Instance}}"
                                    Style="{StaticResource BtnSecondary}" MinWidth="90" Margin="0,0,10,0"
                                    Visibility="Collapsed" Click="ResourcesSkip_Click"/>
                            <Button x:Name="ResourcesRetryButton" Content="{Binding [retry], Source={x:Static loc:Loc.Instance}}"
                                    Style="{StaticResource BtnPrimary}" MinWidth="90"
                                    Visibility="Collapsed" Click="ResourcesRetry_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>