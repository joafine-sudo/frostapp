<Window x:Class="FrostClient.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:FrostClient"
        Title="Frost Client"
        Width="1120" Height="700"
        MinWidth="900" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Loaded="Window_Loaded">

    <Window.Resources>
        <!-- COLORS -->
        <SolidColorBrush x:Key="TextMuted"  Color="#9AA3B5"/>
        <SolidColorBrush x:Key="PanelBg"    Color="#1B1B1B"/>
        <SolidColorBrush x:Key="PanelEdge"  Color="#0A0A0A"/>

        <!-- ICONS -->
        <Geometry x:Key="IconClose">M5,5 L19,19 M19,5 L5,19</Geometry>
        <Geometry x:Key="IconMin">M4,12 H20</Geometry>
        <Geometry x:Key="IconPlay">M8,5 L19,12 L8,19 Z</Geometry>
