<Window x:Class="FrostClient.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Frost Client" Width="1120" Height="720" MinWidth="900" MinHeight="620"
        WindowStartupLocation="CenterScreen" Loaded="Window_Loaded"
        WindowStyle="None" AllowsTransparency="True" 
        Icon="pack://application:,,,/icon.ico">

    <Window.Resources>
        <!-- Cores Base -->
        <SolidColorBrush x:Key="OverlayBg" Color="#99000000"/>
        <SolidColorBrush x:Key="PanelGlass" Color="#E6151518"/>
        <SolidColorBrush x:Key="SidebarGlass" Color="#E6101012"/>
        <SolidColorBrush x:Key="Border" Color="#4AFFFFFF"/>
        <SolidColorBrush x:Key="Text" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="Muted" Color="#C0C0C0C8"/>
        <SolidColorBrush x:Key="Accent" Color="#5B9DFF"/>
        <SolidColorBrush x:Key="ItemHover" Color="#40FFFFFF"/>

        <LinearGradientBrush x:Key="PlayGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#5B9DFF" Offset="0.0"/>
            <GradientStop Color="#3B7BFF" Offset="1.0"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="PlayGradientHover" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#7AB3FF" Offset="0.0"/>
            <GradientStop Color="#5B9DFF" Offset="1.0"/>
        </LinearGradientBrush>

        <!-- Ícones Vetoriais -->
        <Geometry x:Key="IconHome">M10,20V14H14V20H19V12H22L12,3L2,12H5V20H10Z</Geometry>
        <Geometry x:Key="IconBox">M12,2L2,7V17L12,22L22,17V7L12,2M12,4.5L19.5,8L12,11.5L4.5,8L12,4.5M4,9.5L11,13V19.5L4,16V9.5M13,19.5V13L20,9.5V16L13,19.5Z</Geometry>
        <Geometry x:Key="IconSettings">M12,15.5A3.5,3.5 0 0,1 8.5,12A3.5,3.5 0 0,1 12,8.5A3.5,3.5 0 0,1 15.5,12A3.5,3.5 0 0,1 12,15.5M19.43,12.97C19.47,12.65 19.5,12.33 19.5,12C19.5,11.67 19.47,11.34 19.43,11L21.54,9.37C21.73,9.22 21.78,8.95 21.66,8.73L19.66,5.27C19.54,5.05 19.27,4.96 19.05,5.05L16.56,6.05C16.04,5.66 15.5,5.32 14.87,5.07L14.5,2.42C14.46,2.18 14.25,2 14,2H10C9.75,2 9.54,2.18 9.5,2.42L9.13,5.07C8.5,5.32 7.96,5.66 7.44,6.05L4.95,5.05C4.73,4.96 4.46,5.05 4.34,5.27L2.34,8.73C2.21,8.95 2.27,9.22 2.46,9.37L4.57,11C4.53,11.34 4.5,11.67 4.5,12C4.5,12.33 4.53,12.65 4.57,12.97L2.46,14.63C2.27,14.78 2.21,15.05 2.34,15.27L4.34,18.73C4.46,18.95 4.73,19.03 4.95,18.95L7.44,17.94C7.96,18.34 8.5,18.68 9.13,18.93L9.5,21.58C9.54,21.82 9.75,22 10,22H14C14.25,22 14.46,21.82 14.5,21.58L14.87,18.93C15.5,18.68 16.04,18.34 16.56,17.94L19.05,18.95C19.27,19.03 19.54,18.95 19.66,18.73L21.66,15.27C21.78,15.05 21.73,14.78 21.54,14.63L19.43,12.97Z</Geometry>
        <Geometry x:Key="IconUser">M12,4A4,4 0 0,1 16,8A4,4 0 0,1 12,12A4,4 0 0,1 8,8A4,4 0 0,1 12,4M12,14C16.42,14 20,15.79 20,18V20H4V18C4,15.79 7.58,14 12,14Z</Geometry>
        <Geometry x:Key="IconFolder">M10,4H4C2.89,4 2,4.89 2,6V18A2,2 0 0,0 4,20H20A2,2 0 0,0 22,18V8C22,6.89 21.1,6 20,6H12L10,4Z</Geometry>
        <Geometry x:Key="IconClose">M19,6.41L17.59,5L12,10.59L6.41,5L5,6.41L10.59,12L5,17.59L6.41,19L12,13.41L17.59,19L19,17.59L13.41,12L19,6.41Z</Geometry>
        <Geometry x:Key="IconMinimize">M20,14H4V10H20V14Z</Geometry>
        <Geometry x:Key="IconChevronDown">M7.41,8.58L12,13.17L16.59,8.58L18,10L12,16L6,10L7.41,8.58Z</Geometry>
        <Geometry x:Key="IconDiscord">M22.32,5.33A19.79,19.79 0 0,0 17.45,3.8C17.35,3.79 17.25,3.84 17.2,3.93C17.07,4.17 16.93,4.48 16.83,4.73C15.21,4.49 13.6,4.49 12,4.49C10.4,4.49 8.79,4.49 7.17,4.73C7.07,4.48 6.93,4.17 6.8,3.93C6.75,3.84 6.65,3.79 6.55,3.8A19.79,19.79 0 0,0 1.68,5.33C1.63,5.35 1.58,5.39 1.55,5.44C-1.29,9.69 -0.47,13.83 0.41,17.92C0.42,17.98 0.46,18.04 0.51,18.08A19.88,19.88 0 0,0 6.51,21.12C6.61,21.15 6.71,21.11 6.77,21.03C7.05,20.65 7.29,20.25 7.49,19.83C7.55,19.71 7.49,19.57 7.37,19.53C6.86,19.34 6.37,19.1 5.9,18.83C5.77,18.75 5.76,18.57 5.87,18.48C6.23,18.21 6.58,17.92 6.91,17.61C6.98,17.55 7.08,17.54 7.16,17.58C10.21,18.97 13.57,18.97 16.84,17.58C16.92,17.54 17.02,17.55 17.09,17.61C17.42,17.92 17.77,18.21 18.13,18.48C18.24,18.57 18.23,18.75 18.1,18.83C17.63,19.1 17.14,19.34 16.63,19.53C16.51,19.57 16.45,19.71 16.51,19.83C16.71,20.25 16.95,20.65 17.23,21.03C17.29,21.11 17.39,21.15 17.49,21.12A19.88,19.88 0 0,0 23.49,18.08C23.54,18.04 23.58,17.98 23.59,17.92C24.62,13.19 23.34,9.08 22.45,5.44C22.42,5.39 22.37,5.35 22.32,5.33M8.02,15.39C6.85,15.39 5.88,14.32 5.88,13C5.88,11.68 6.83,10.61 8.02,10.61C9.22,10.61 10.18,11.69 10.16,13C10.16,14.32 9.21,15.39 8.02,15.39M15.98,15.39C14.81,15.39 13.84,14.32 13.84,13C13.84,11.68 14.79,10.61 15.98,10.61C17.18,10.61 18.14,11.69 18.12,13C18.12,14.32 17.18,15.39 15.98,15.39Z</Geometry>

        <!-- Estilos -->
        <Style x:Key="NavButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="Margin" Value="10,2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Fill="{TemplateBinding Foreground}" Width="20" Height="20" Stretch="Uniform" Margin="0,0,14,0" VerticalAlignment="Center"/>
                                <ContentPresenter VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource ItemHover}"/>
                                <Setter Property="Foreground" Value="{StaticResource Text}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PlayButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource PlayGradient}"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource PlayGradientHover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource ItemHover}"/>
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#60FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TextLinkButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" Padding="10,5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource Text}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#30000000"/>
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="Margin" Value="0,5,0,15"/>
            <Setter Property="CaretBrush" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#30000000"/>
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="Margin" Value="0,5,0,15"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton" Focusable="False" ClickMode="Press" 
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Border" Background="{StaticResource PanelGlass}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="30"/>
                                                </Grid.ColumnDefinitions>
                                                <ContentPresenter Grid.Column="0" Margin="12,10" Content="{Binding SelectionBoxItem, RelativeSource={RelativeSource AncestorType=ComboBox}}" ContentTemplate="{Binding SelectionBoxItemTemplate, RelativeSource={RelativeSource AncestorType=ComboBox}}" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                                                <Path Grid.Column="1" Data="{StaticResource IconChevronDown}" Fill="{StaticResource Muted}" Width="12" Height="12" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource Muted}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            
                            <Popup x:Name="PART_Popup" AllowsTransparency="True" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" Focusable="False" PopupAnimation="Slide">
                                <Border Background="{StaticResource PanelGlass}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="8" Margin="0,4,0,0" MinWidth="{TemplateBinding ActualWidth}" MaxHeight="250">
                                    <ScrollViewer>
                                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained" Margin="4"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource ItemHover}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Accent}"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
        </Style>
    </Window.Resources>

    <Border CornerRadius="12" BorderBrush="{StaticResource Border}" BorderThickness="1" ClipToBounds="True">
        <Border.Background>
            <ImageBrush ImageSource="/snow.png" Stretch="UniformToFill"/>
        </Border.Background>

        <Grid>
            <Rectangle Fill="{StaticResource OverlayBg}" />

            <!-- MENU PRINCIPAL DO LAUNCHER -->
            <Grid x:Name="MainLauncherUI" IsHitTestVisible="False">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="32"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border x:Name="SidebarMenu" Grid.Column="0" Background="{StaticResource SidebarGlass}" BorderBrush="{StaticResource Border}" BorderThickness="0,0,1,0" CornerRadius="12,0,0,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Margin="20,24" Orientation="Horizontal">
                                <TextBlock Text="FROST CLIENT" FontSize="18" FontWeight="Bold" VerticalAlignment="Center" Foreground="{StaticResource Text}"/>
                            </StackPanel>

                            <StackPanel Grid.Row="1" Margin="0,10,0,0">
                                <Button Style="{StaticResource NavButtonStyle}" Tag="{StaticResource IconHome}" Content="Home" Click="HomeNav_Click"/>
                                <Button Style="{StaticResource NavButtonStyle}" Tag="{StaticResource IconBox}" Content="Versions" Click="VersionsNav_Click"/>
                                <Button Style="{StaticResource NavButtonStyle}" Tag="{StaticResource IconUser}" Content="Account" Click="AccountNav_Click"/>
                                <Button Style="{StaticResource NavButtonStyle}" Tag="{StaticResource IconSettings}" Content="Settings" Click="SettingsNav_Click"/>
                            </StackPanel>

                            <StackPanel Grid.Row="2" Margin="10,0,10,20">
                                <Button Style="{StaticResource NavButtonStyle}" Tag="{StaticResource IconFolder}" Content="Mods Folder" Click="OpenModsFolder_Click"/>
                                <Button Style="{StaticResource NavButtonStyle}" Tag="{StaticResource IconFolder}" Content="Game Folder" Click="OpenGameFolder_Click"/>
                                <Button Style="{StaticResource NavButtonStyle}" Tag="{StaticResource IconDiscord}" Content="Discord" Click="Website_Click"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Grid Grid.Column="1" Margin="40,0,40,0">
                        <!-- PÁGINA: HOME -->
                        <Grid x:Name="HomePage">
                            <StackPanel VerticalAlignment="Center" MaxWidth="520" HorizontalAlignment="Left">
                                <TextBlock Text="YOUR GAME. YOUR WAY." Foreground="{StaticResource Muted}" FontSize="12" FontWeight="SemiBold"/>
                                <TextBlock Text="Welcome to Frost" FontSize="42" FontWeight="Bold" Margin="0,10,0,6" Foreground="{StaticResource Text}"/>
                                <TextBlock Text="A clean, minimal launcher for your Minecraft installations." Foreground="{StaticResource Muted}" FontSize="15" Margin="0,0,0,40" TextWrapping="Wrap"/>
                                
                                <Border Background="{StaticResource PanelGlass}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="16" Padding="28">
                                    <StackPanel>
                                        <TextBlock Text="SELECTED VERSION" Foreground="{StaticResource Muted}" FontSize="11" FontWeight="Bold"/>
                                        <TextBlock x:Name="HomeVersionLabel" Text="No version selected" FontSize="24" FontWeight="Bold" Margin="0,8,0,20" Foreground="{StaticResource Text}"/>
                                        
                                        <ComboBox x:Name="VersionBox" SelectionChanged="Version_Changed" Height="48" PreviewMouseWheel="ComboBox_PreviewMouseWheel"/>
                                        
                                        <Button x:Name="PlayButton" Content="LAUNCH MINECRAFT" Style="{StaticResource PlayButtonStyle}" Height="56" Click="Play_Click"/>
                                    </StackPanel>
                                </Border>
                                
                                <TextBlock Text="Tip: Install a version from the Versions page before launching." Foreground="{StaticResource Muted}" FontSize="12" Margin="0,20,0,0"/>
                            </StackPanel>
                        </Grid>

                        <!-- PÁGINA: VERSIONS -->
                        <Grid x:Name="VersionsPage" Visibility="Collapsed" VerticalAlignment="Center">
                            <StackPanel MaxWidth="560" HorizontalAlignment="Left">
                                <TextBlock Text="Game Versions" FontSize="36" FontWeight="Bold" Margin="0,0,0,8"/>
                                <TextBlock Text="Install vanilla Minecraft." Foreground="{StaticResource Muted}" FontSize="15" Margin="0,0,0,30"/>
                                
                                <TextBlock Text="Minecraft version" Foreground="{StaticResource Muted}" FontSize="12"/>
                                <ComboBox x:Name="InstallVersionBox" Height="48" PreviewMouseWheel="ComboBox_PreviewMouseWheel"/>
                                
                                <Button Content="Install Selected Version" Style="{StaticResource PlayButtonStyle}" Height="50" Click="InstallVersion_Click" Margin="0,10,0,10"/>
                                <Button Content="Refresh Installed Versions" Background="{StaticResource PanelGlass}" Foreground="{StaticResource Text}" BorderBrush="{StaticResource Border}" BorderThickness="1" Padding="12" Cursor="Hand" Click="RefreshVersions_Click"/>
                                
                                <TextBlock x:Name="InstallStatusText" Text="Version list will load when the launcher starts." TextWrapping="Wrap" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,20,0,0"/>
                            </StackPanel>
                        </Grid>

                        <!-- PÁGINA: ACCOUNT -->
                        <Grid x:Name="AccountPage" Visibility="Collapsed" VerticalAlignment="Center">
                            <StackPanel MaxWidth="560" HorizontalAlignment="Left">
                                <TextBlock Text="Account" FontSize="36" FontWeight="Bold" Margin="0,0,0,30"/>
                                <Border Background="{StaticResource PanelGlass}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="16" Padding="24">
                                    <StackPanel>
                                        <TextBlock Text="ACCOUNT STATUS" Foreground="{StaticResource Muted}" FontSize="11" FontWeight="SemiBold"/>
                                        <TextBlock x:Name="AccountStatusDetail" Text="Offline mode." FontSize="20" Margin="0,10,0,20" Foreground="{StaticResource Text}"/>
                                        <Button x:Name="MicrosoftLoginButton" Content="Sign in with Microsoft" Style="{StaticResource PlayButtonStyle}" Height="50" Click="MicrosoftLogin_Click" Margin="0,0,0,15"/>
                                        
                                        <TextBlock Text="Or change the application's offline name:" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,15,0,5"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox x:Name="AccountOfflineNameBox" Grid.Column="0" Margin="0,0,10,0"/>
                                            <Button Grid.Column="1" Content="Save Name" Background="{StaticResource ItemHover}" Foreground="{StaticResource Text}" BorderThickness="0" Padding="15,0" Cursor="Hand" Click="SaveOfflineName_Click"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>

                        <!-- PÁGINA: SETTINGS (O Java está aqui!) -->
                        <Grid x:Name="SettingsPage" Visibility="Collapsed" VerticalAlignment="Center">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="520">
                                <StackPanel MaxWidth="560" HorizontalAlignment="Left">
                                    <TextBlock Text="Settings" FontSize="36" FontWeight="Bold" Margin="0,0,0,30"/>
                                    
                                    <TextBlock Text="Player name" Foreground="{StaticResource Muted}" FontSize="12"/>
                                    <TextBox x:Name="UsernameBox" TextChanged="SettingsText_Changed"/>
                                    
                                    <TextBlock Text="Memory allocation" Foreground="{StaticResource Muted}" FontSize="12"/>
                                    <Slider x:Name="RamSlider" Minimum="1" Maximum="16" Value="4" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="RamSlider_Changed" Margin="0,10,0,5"/>
                                    <TextBlock x:Name="RamLabel" Text="4 GB" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,0,0,20"/>
                                    
                                    <!-- CAMPO JAVA -->
                                    <TextBlock Text="Java 8 Path (required for Forge 1.8.9)" Foreground="{StaticResource Muted}" FontSize="12"/>
                                    <Grid Margin="0,5,0,15">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="JavaPathBox" Grid.Column="0" Margin="0,0,10,0" TextChanged="SettingsText_Changed"/>
                                        <Button Grid.Column="1" Content="Browse..." Background="{StaticResource ItemHover}" Foreground="{StaticResource Text}" BorderThickness="0" Padding="15,0" Cursor="Hand" Click="BrowseJavaPath_Click"/>
                                    </Grid>

                                    <TextBlock Text="Additional Java arguments" Foreground="{StaticResource Muted}" FontSize="12"/>
                                    <TextBox x:Name="JavaArgumentsBox" TextChanged="SettingsText_Changed"/>
                                    
                                    <Button Content="Save Settings" Style="{StaticResource PlayButtonStyle}" Height="50" Click="SaveSettings_Click" Margin="0,10,0,10"/>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </Grid>
                </Grid>

                <Border Grid.Row="1" Background="{StaticResource SidebarGlass}" BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0" CornerRadius="0,0,12,12">
                    <DockPanel Margin="15,0">
                        <TextBlock x:Name="StatusText" Text="Ready" Foreground="{StaticResource Muted}" VerticalAlignment="Center" FontSize="11"/>
                        <TextBlock Text="FROST CLIENT  •  v1.0.0" Foreground="{StaticResource Muted}" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="11"/>
                    </DockPanel>
                </Border>
            </Grid>

            <!-- BOTÕES DE MINIMIZAR E FECHAR -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,10,10,0" Panel.ZIndex="10">
                <Button Background="Transparent" BorderThickness="0" Width="36" Height="36" Cursor="Hand" Click="Minimize_Click" ToolTip="Minimize">
                    <Path Data="{StaticResource IconMinimize}" Fill="{StaticResource Text}" Width="14" Height="14" Stretch="Uniform"/>
                </Button>
                <Button Background="Transparent" BorderThickness="0" Width="36" Height="36" Cursor="Hand" Click="Close_Click" ToolTip="Close">
                    <Path Data="{StaticResource IconClose}" Fill="{StaticResource Text}" Width="14" Height="14" Stretch="Uniform"/>
                </Button>
            </StackPanel>

            <!-- ============================================== -->
            <!-- WIZARD INICIAL: 3 PASSOS                       -->
            <!-- ============================================== -->

            <!-- ECRÃ 1: WELCOME -->
            <Grid x:Name="WizardScreen_Welcome" Panel.ZIndex="20" Background="#E60D0D0F" Grid.RowSpan="2" IsHitTestVisible="True">
                <Border Background="{StaticResource PanelGlass}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="20" Padding="40" Width="480" Height="320" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <StackPanel>
                        <TextBlock Text="WELCOME TO FROST" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,20,0,10"/>
                        <TextBlock Text="Let's get you set up. First, we need to configure a few things." Foreground="{StaticResource Muted}" TextWrapping="Wrap" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,0,0,40"/>
                        <Button Content="Next" Style="{StaticResource PlayButtonStyle}" Height="50" Click="Wizard_Step1_Next_Click" Margin="0,0,0,15"/>
                        <Button Content="Close Launcher" Style="{StaticResource TextLinkButtonStyle}" Click="Close_Click"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ECRÃ 2: SELECT JAVA -->
            <Grid x:Name="WizardScreen_Java" Panel.ZIndex="20" Background="#E60D0D0F" Visibility="Collapsed" Grid.RowSpan="2" IsHitTestVisible="True">
                <Border Background="{StaticResource PanelGlass}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="20" Padding="40" Width="480" Height="380" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <StackPanel>
                        <TextBlock Text="SELECT JAVA VERSION" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                        <TextBlock Text="Forge 1.8.9 requires Java 8. Please select your javaw.exe file." Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,20"/>
                        
                        <Grid Margin="0,0,0,30">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="WizardJavaPathBox" Grid.Column="0" Margin="0,0,10,0" IsReadOnly="True" Height="40"/>
                            <Button Grid.Column="1" Content="Browse..." Style="{StaticResource SecondaryButtonStyle}" Padding="15,0" Height="40" Cursor="Hand" Click="Wizard_BrowseJava_Click"/>
                        </Grid>

                        <Button Content="Next" Style="{StaticResource PlayButtonStyle}" Height="50" Click="Wizard_Step2_Next_Click" Margin="0,0,0,15"/>
                        <Button Content="Back" Style="{StaticResource TextLinkButtonStyle}" Click="Wizard_Step2_Back_Click"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ECRÃ 3: LOGIN -->
            <Grid x:Name="WizardScreen_Login" Panel.ZIndex="20" Background="#E60D0D0F" Visibility="Collapsed" Grid.RowSpan="2" IsHitTestVisible="True">
                <Border Background="{StaticResource PanelGlass}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="20" Padding="40" Width="480" Height="400" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <StackPanel>
                        <TextBlock Text="LOGIN" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                        <TextBlock Text="Choose how you want to play." Foreground="{StaticResource Muted}" TextAlignment="Center" Margin="0,0,0,30"/>
                        
                        <Button Content="Sign in with Microsoft" Style="{StaticResource PlayButtonStyle}" Height="50" Click="Wizard_LoginMicrosoft_Click" Margin="0,0,0,20"/>
                        
                        <TextBlock Text="Or play offline:" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,0,0,10"/>
                        <Button Content="Continue Offline" Style="{StaticResource SecondaryButtonStyle}" Height="50" Click="Wizard_LoginOffline_Click"/>
                        
                        <Button Content="Back" Style="{StaticResource TextLinkButtonStyle}" Click="Wizard_Step4_Back_Click" Margin="0,20,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
            
        </Grid>
    </Border>
</Window>