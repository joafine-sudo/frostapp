        <Geometry x:Key="IconDelete">M6,19 A2,2 0 0,0 8,21 H16 A2,2 0 0,0 18,19 V7 H6 V19 Z M19,4 H15.5 L14.5,3 H9.5 L8.5,4 H5 V6 H19 V4 Z</Geometry>

        <!-- SCROLLBAR (thin, dark) -->
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="6"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid>
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="#2B4A7A" CornerRadius="3" Margin="1"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== TEXT STYLES ===== -->
        <Style x:Key="PageTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="26"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
        <Style x:Key="PageSub" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
            <Setter Property="Margin" Value="0,0,0,22"/>
        </Style>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
            <Setter Property="Margin" Value="0,0,0,7"/>
        </Style>
        <Style x:Key="RowTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style x:Key="RowDesc" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
            <Setter Property="Margin" Value="0,3,0,0"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <!-- ===== CARD ===== -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBg}"/>
            <Setter Property="BorderBrush" Value="{StaticResource CardBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="20"/>
        </Style>
        <Style x:Key="SettingRow" TargetType="Border">
            <Setter Property="BorderBrush" Value="#16264D"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Padding" Value="22,15"/>
        </Style>

        <!-- ===== TEXTBOX ===== -->
        <Style x:Key="TB" TargetType="TextBox">
            <Setter Property="Background" Value="#080F22"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#1C3358"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="CaretBrush" Value="White"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- ===== COMBOBOX ===== -->
        <Style x:Key="CBI" TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="12,9"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}" CornerRadius="5" Margin="3,1">
                            <ContentPresenter TextElement.Foreground="White"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#16295A"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1E3570"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CB" TargetType="ComboBox">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="MinHeight" Value="38"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource CBI}"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Focusable="False" ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Bd" Background="#080F22" BorderBrush="#1C3358"
                                                BorderThickness="1" CornerRadius="8">
                                            <Path HorizontalAlignment="Right" VerticalAlignment="Center"
                                                  Margin="0,0,13,0" Fill="#7B90B8" Data="M0,0 L4,4 L8,0 Z"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="BorderBrush" Value="#60A5FA"/>
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Bd" Property="BorderBrush" Value="#60A5FA"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              Margin="14,0,34,0" VerticalAlignment="Center"
                                              TextElement.Foreground="White"/>
                            <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom"
                                   AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
                                <Grid Width="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                      MaxHeight="260" SnapsToDevicePixels="True">
                                    <Border Background="#0A1428" BorderBrush="#1C3358" BorderThickness="1"
                                            CornerRadius="8" Margin="0,4,0,0">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,4">
                                            <StackPanel IsItemsHost="True"
                                                        KeyboardNavigation.DirectionalNavigation="Contained"/>
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== TOGGLE ===== -->
        <Style x:Key="Toggle" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="Tr" Width="44" Height="24" CornerRadius="12" Background="#1C3358">
                            <Ellipse x:Name="Kn" Width="18" Height="18" Fill="White"
                                     HorizontalAlignment="Left" Margin="3,0,0,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Tr" Property="Background" Value="#3B82F6"/>
                                <Setter TargetName="Kn" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="Kn" Property="Margin" Value="0,0,3,0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== BUTTONS ===== -->
        <Style x:Key="BtnPrimary" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource PlayGrad}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="20,12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#60A5FA"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BtnSecondary" TargetType="Button">
            <Setter Property="Background" Value="#0D1E3A"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#1C3358"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#162545"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Small icon button -->
        <Style x:Key="BtnIcon" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="7">
                            <Path Data="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
                                  Fill="{TemplateBinding Foreground}"
                                  Width="16" Height="16" Stretch="Uniform"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#0D1E3A"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Window chrome buttons (stroke) -->
        <Style x:Key="BtnChrome" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="7">
                            <Path Data="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
                                  Stroke="{TemplateBinding Foreground}" StrokeThickness="1.8"
                                  Width="13" Height="13" Stretch="Uniform"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#0D1E3A"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Sidebar nav buttons (Lunar rail style) -->
        <Style x:Key="NavBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Width" Value="56"/>
            <Setter Property="Height" Value="52"/>
            <Setter Property="Margin" Value="0,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="10">
                            <Path Data="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
                                  Fill="{TemplateBinding Foreground}"
                                  Width="22" Height="22" Stretch="Uniform"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#0D1E3A"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NavBtnActive" TargetType="Button" BasedOn="{StaticResource NavBtn}">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <!-- Active accent bar on left -->
                            <Rectangle Width="3" VerticalAlignment="Stretch" HorizontalAlignment="Left"
                                       Fill="#3B82F6" RadiusX="2" RadiusY="2" Margin="-4,8,0,8"/>
                            <Border x:Name="Bd" Background="#0D2040" CornerRadius="10" Margin="4,0,4,0">
                                <Path Data="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
                                      Fill="{TemplateBinding Foreground}"
                                      Width="22" Height="22" Stretch="Uniform"/>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Chip button (JVM presets) -->
        <Style x:Key="BtnChip" TargetType="Button">
            <Setter Property="Background" Value="#080F22"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="#1C3358"
                                BorderThickness="1" CornerRadius="8" Padding="14,6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#60A5FA"/>
                                <Setter TargetName="Bd" Property="Background" Value="#0D1E3A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Version card (Badlion-style, horizontal) -->
        <Style x:Key="VersionCard" TargetType="Border">
            <Setter Property="Background" Value="#0A1428"/>
            <Setter Property="BorderBrush" Value="#1C3358"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
    </Window.Resources>

    <!-- ====================== ROOT ====================== -->
    <Border CornerRadius="14" Background="#07101F" BorderBrush="#1C3358" BorderThickness="1" ClipToBounds="True">
        <Grid>
            <!-- Background image -->
            <Grid.Background>
                <ImageBrush ImageSource="snow.png" Stretch="UniformToFill" Opacity="0.45"/>
            </Grid.Background>
            <Rectangle>
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#D0070F1E" Offset="0"/>
                        <GradientStop Color="#F5060D1A" Offset="1"/>
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>

            <!-- =================== MAIN UI =================== -->
            <Grid x:Name="MainLauncherUI">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="56"/>
                </Grid.ColumnDefinitions>

                <!-- ====== LEFT SIDEBAR (Lunar icon rail) ====== -->
                <Border Grid.Column="0" Background="{StaticResource SidebarBg}"
                        BorderBrush="{StaticResource CardBorder}" BorderThickness="0,0,1,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Logo -->
                        <Border Width="40" Height="40" CornerRadius="12" Background="#0D2040"
                                Margin="0,20,0,24" HorizontalAlignment="Center">
                            <TextBlock Text="❄" FontSize="24" Foreground="#60A5FA"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <!-- Nav buttons -->
                        <StackPanel x:Name="SidebarMenu" Grid.Row="1" HorizontalAlignment="Center">
                            <Button x:Name="NavHome"    Style="{StaticResource NavBtn}"
                                    Tag="{StaticResource IconPlay}"     ToolTip="Play"         Click="HomeNav_Click"/>
                            <Button x:Name="NavVersions" Style="{StaticResource NavBtn}"
                                    Tag="{StaticResource IconVersions}" ToolTip="Versions"     Click="VersionsNav_Click"/>
                            <Button x:Name="NavSettings" Style="{StaticResource NavBtn}"
                                    Tag="{StaticResource IconSettings}" ToolTip="Settings"     Click="SettingsNav_Click"/>
                            <Button x:Name="NavAccount"  Style="{StaticResource NavBtn}"
                                    Tag="{StaticResource IconAccount}"  ToolTip="Account"      Click="AccountNav_Click"/>
                        </StackPanel>

                        <!-- Version label -->
                        <StackPanel Grid.Row="2" Margin="0,0,0,16" HorizontalAlignment="Center">
                            <Ellipse Width="8" Height="8" Fill="#10B981" HorizontalAlignment="Center"/>
                            <TextBlock Text="v1.0.11" Foreground="{StaticResource TextMuted}"
                                       FontSize="9" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ====== CENTRE CONTENT ====== -->
                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="56"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="36"/>
                    </Grid.RowDefinitions>

                    <!-- TOP BAR (drag + account chip) -->
                    <Grid Grid.Row="0" Background="#44060D1A"
                          MouseLeftButtonDown="TopBar_MouseLeftButtonDown">
                        <TextBlock Text="FROST CLIENT" FontSize="10" FontWeight="Bold"
                                   Foreground="#2A4A7A" VerticalAlignment="Center" Margin="22,0,0,0"/>

                        <!-- Account chip (Lunar style) -->
                        <Button HorizontalAlignment="Right" VerticalAlignment="Center"
                                Margin="0,0,14,0" Cursor="Hand" Focusable="False"
                                Click="AccountNav_Click" BorderThickness="0">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bd" CornerRadius="10" Padding="8,0,16,0"
                                            BorderBrush="#3B82F6" BorderThickness="1" MinWidth="180">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                <GradientStop Color="#2563EB" Offset="0"/>
                                                <GradientStop Color="#1D4ED8" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                        <ContentPresenter VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="BorderBrush" Value="#93C5FD"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                            <StackPanel Orientation="Horizontal">
                                <Border Width="36" Height="36" CornerRadius="7" Background="#0A1428"
                                        ClipToBounds="True" Margin="0,0,10,0">
                                    <Image x:Name="TopAvatar" Stretch="UniformToFill"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Playing as" FontSize="9" Foreground="#BFDBFE"/>
                                    <TextBlock x:Name="TopPlayerName" Text="Not logged in"
                                               FontSize="13" FontWeight="Black" Foreground="White"/>
                                </StackPanel>
                            </StackPanel>
                        </Button>

                        <!-- Close / minimize -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                    VerticalAlignment="Top" Margin="0,6,6,0">
                            <Button Style="{StaticResource BtnChrome}" Tag="{StaticResource IconMin}"
                                    Click="Minimize_Click"/>
                            <Button Style="{StaticResource BtnChrome}" Tag="{StaticResource IconClose}"
                                    Click="Close_Click"/>
                        </StackPanel>
                    </Grid>

                    <!-- ====== PAGES ====== -->
                    <Grid Grid.Row="1" Margin="28,22,28,16">

                        <!-- === HOME (Lunar hero + Badlion quick info) === -->
                        <Grid x:Name="HomePage" Visibility="Visible">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Hero area -->
                            <Grid>
                                <!-- Snowflake watermarks -->
                                <TextBlock Text="❄" FontSize="160" Foreground="#09FFFFFF"
                                           HorizontalAlignment="Left"  VerticalAlignment="Top" Margin="20,10,0,0"/>
                                <TextBlock Text="❄" FontSize="100" Foreground="#07FFFFFF"
                                           HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,30,20"/>

                                <!-- Skin render -->
                                <Image x:Name="HomeBody" Height="270" HorizontalAlignment="Left"
                                       VerticalAlignment="Bottom" Margin="30,0,0,0"/>

                                <!-- Centre content -->
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="360">
                                    <TextBlock Text="Frost Client" FontSize="38" FontWeight="Black"
                                               Foreground="White" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="HomeSubText" Text="Ready when you are."
                                               FontSize="13" Foreground="{StaticResource TextMuted}"
                                               HorizontalAlignment="Center" Margin="0,6,0,24"/>

                                    <TextBlock Text="VERSION" Style="{StaticResource Label}"
                                               HorizontalAlignment="Left"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <ComboBox x:Name="VersionBox" Style="{StaticResource CB}"
                                                  SelectionChanged="Version_Changed"
                                                  PreviewMouseWheel="CB_Wheel"/>
                                        <!-- Rename button (pencil) -->
                                        <Button Grid.Column="1" Style="{StaticResource BtnIcon}"
                                                Tag="{StaticResource IconEdit}"
                                                ToolTip="Rename this version"
                                                Margin="8,0,0,0"
                                                Click="RenameVersion_Click"/>
                                    </Grid>

                                    <Button x:Name="PlayButton" Style="{StaticResource BtnPrimary}"
                                            Content="PLAY" FontSize="20" Height="56"
                                            HorizontalAlignment="Stretch" Margin="0,14,0,0"
                                            Click="Play_Click">
                                        <Button.Effect>
                                            <DropShadowEffect Color="#3B82F6" BlurRadius="28"
                                                              ShadowDepth="0" Opacity="0.45"/>
                                        </Button.Effect>
                                    </Button>

                                    <TextBlock x:Name="HomeVersionLabel" Text=""
                                               FontSize="11" Foreground="{StaticResource TextMuted}"
                                               HorizontalAlignment="Center" Margin="0,10,0,0"/>
                                </StackPanel>
                            </Grid>

                            <!-- Quick action strip (Badlion style) -->
                            <StackPanel Grid.Row="1" Orientation="Horizontal"
                                        HorizontalAlignment="Center" Margin="0,0,0,4">
                                <Button Style="{StaticResource BtnSecondary}"
                                        Padding="18,10" Margin="0,0,10,0"
                                        Click="OpenGameFolder_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource IconFolder}" Fill="White"
                                              Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0"/>
                                        <TextBlock Text="OPEN .MINECRAFT" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource BtnSecondary}"
                                        Padding="18,10"
                                        Click="OpenModsFolder_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource IconFolder}" Fill="White"
                                              Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0"/>
                                        <TextBlock Text="OPEN MODS FOLDER" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>

                        <!-- === VERSIONS (Badlion manage list) === -->
                        <Grid x:Name="VersionsPage" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <StackPanel>
                                <TextBlock Text="Versions" Style="{StaticResource PageTitle}"/>
                                <TextBlock Text="Install and manage your Minecraft versions."
                                           Style="{StaticResource PageSub}"/>
                            </StackPanel>

                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="320"/>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Install panel -->
                                <Border Style="{StaticResource Card}" VerticalAlignment="Top">
                                    <StackPanel>
                                        <TextBlock Text="INSTALL NEW VERSION"
                                                   Style="{StaticResource Label}" Margin="0,0,0,12"/>
                                        <TextBlock Text="Minecraft version" Style="{StaticResource Label}"/>
                                        <ComboBox x:Name="InstallVersionBox" Style="{StaticResource CB}"
                                                  Margin="0,0,0,14"
                                                  PreviewMouseWheel="CB_Wheel"/>

                                        <Button x:Name="InstallButton"
                                                Content="DOWNLOAD AND INSTALL"
                                                Style="{StaticResource BtnPrimary}"
                                                Margin="0,0,0,12"
                                                Click="InstallVersion_Click"/>

                                        <ProgressBar x:Name="InstallProgress" Height="4"
                                                     Visibility="Collapsed" IsIndeterminate="True"
                                                     Foreground="#3B82F6" Background="#0D1E3A"
                                                     BorderThickness="0" Margin="0,0,0,10"/>

                                        <Border Background="#080F22" CornerRadius="7" Padding="12">
                                            <TextBlock x:Name="InstallStatusText"
                                                       Text="Waiting for installation…"
                                                       FontSize="10" Foreground="{StaticResource TextMuted}"
                                                       TextWrapping="Wrap"/>
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <!-- Installed list -->
                                <Grid Grid.Column="2">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <Grid Margin="0,0,0,12">
                                        <TextBlock Text="INSTALLED VERSIONS"
                                                   Style="{StaticResource Label}"
                                                   VerticalAlignment="Center"/>
                                        <Button Content="REFRESH" Style="{StaticResource BtnSecondary}"
                                                HorizontalAlignment="Right" Padding="14,7"
                                                Click="RefreshVersions_Click"/>
                                    </Grid>

                                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                        <ItemsControl x:Name="VersionList">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Style="{StaticResource VersionCard}">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>

                                                            <!-- Letter badge -->
                                                            <Border Width="38" Height="38" CornerRadius="9"
                                                                    Background="#0D2040" Margin="0,0,14,0">
                                                                <TextBlock Text="{Binding Letter}"
                                                                           Foreground="#60A5FA"
                                                                           FontWeight="Black" FontSize="13"
                                                                           HorizontalAlignment="Center"
                                                                           VerticalAlignment="Center"/>
                                                            </Border>

                                                            <!-- Name + type -->
                                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding DisplayName}"
                                                                           Foreground="White" FontWeight="SemiBold"
                                                                           FontSize="13"
                                                                           TextTrimming="CharacterEllipsis"/>
                                                                <TextBlock Text="{Binding RealId}"
                                                                           Foreground="{StaticResource TextMuted}"
                                                                           FontSize="10" Margin="0,2,0,0"
                                                                           TextTrimming="CharacterEllipsis"/>
                                                            </StackPanel>

                                                            <!-- Actions -->
                                                            <StackPanel Grid.Column="2" Orientation="Horizontal"
                                                                        VerticalAlignment="Center">
                                                                <Button Tag="{Binding RealId}"
                                                                        Content="SELECT"
                                                                        Style="{StaticResource BtnSecondary}"
                                                                        Padding="12,7" FontSize="10"
                                                                        Margin="0,0,8,0"
                                                                        Click="SelectVersion_Click"/>
                                                                <Button Tag="{Binding RealId}"
                                                                        Style="{StaticResource BtnIcon}"
                                                                        ToolTip="Rename"
                                                                        Click="RenameVersionFromList_Click">
                                                                    <Button.Content>
                                                                        <Path Data="{StaticResource IconEdit}"
                                                                              Fill="{StaticResource TextMuted}"
                                                                              Width="14" Height="14"
                                                                              Stretch="Uniform"/>
                                                                    </Button.Content>
                                                                    <Button.Template>
                                                                        <ControlTemplate TargetType="Button">
                                                                            <Border x:Name="Bd" Background="Transparent" CornerRadius="7" Width="32" Height="32">
                                                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                            </Border>
                                                                            <ControlTemplate.Triggers>
                                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                                    <Setter TargetName="Bd" Property="Background" Value="#0D1E3A"/>
                                                                                </Trigger>
                                                                            </ControlTemplate.Triggers>
                                                                        </ControlTemplate>
                                                                    </Button.Template>
                                                                </Button>
                                                                <Button Tag="{Binding RealId}"
                                                                        Style="{StaticResource BtnIcon}"
                                                                        ToolTip="Delete"
                                                                        Margin="4,0,0,0"
                                                                        Click="DeleteVersion_Click">
                                                                    <Button.Content>
                                                                        <Path Data="{StaticResource IconDelete}"
                                                                              Fill="#EF4444"
                                                                              Width="14" Height="14"
                                                                              Stretch="Uniform"/>
                                                                    </Button.Content>
                                                                    <Button.Template>
                                                                        <ControlTemplate TargetType="Button">
                                                                            <Border x:Name="Bd" Background="Transparent" CornerRadius="7" Width="32" Height="32">
                                                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                            </Border>
                                                                            <ControlTemplate.Triggers>
                                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                                    <Setter TargetName="Bd" Property="Background" Value="#2D0A0A"/>
                                                                                </Trigger>
                                                                            </ControlTemplate.Triggers>
                                                                        </ControlTemplate>
                                                                    </Button.Template>
                                                                </Button>
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Grid>
                            </Grid>
                        </Grid>

                        <!-- === SETTINGS === -->
                        <Grid x:Name="SettingsPage" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <StackPanel>
                                <TextBlock Text="Settings" Style="{StaticResource PageTitle}"/>
                                <TextBlock Text="Customize your Frost Client experience."
                                           Style="{StaticResource PageSub}"/>
                            </StackPanel>

                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                <StackPanel Margin="0,0,10,0">

                                    <!-- GAME SECTION -->
                                    <TextBlock Text="Game" Foreground="{StaticResource TextMuted}"
                                               FontSize="11" FontWeight="SemiBold" Margin="4,0,0,10"/>
                                    <Border Style="{StaticResource Card}" Padding="0" Margin="0,0,0,20">
                                        <StackPanel>
                                            <!-- RAM -->
                                            <Border Style="{StaticResource SettingRow}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock Text="Allocated RAM" Style="{StaticResource RowTitle}"/>
                                                        <TextBlock Text="Memory dedicated to Minecraft" Style="{StaticResource RowDesc}"/>
                                                        <TextBlock Text="Recommended: 4 GB" Foreground="#60A5FA"
                                                                   FontSize="10" Margin="0,5,0,0"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal"
                                                                VerticalAlignment="Center">
                                                        <Slider x:Name="RamSlider" Width="200" Minimum="1" Maximum="16"
                                                                Value="4" TickFrequency="1" IsSnapToTickEnabled="True"
                                                                VerticalAlignment="Center"
                                                                ValueChanged="RamSlider_Changed"/>
                                                        <TextBlock x:Name="RamLabel" Text="4 GB" Width="55"
                                                                   Foreground="White" FontWeight="Bold" FontSize="14"
                                                                   TextAlignment="Right" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>

                                            <!-- Resolution -->
                                            <Border Style="{StaticResource SettingRow}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock Text="Game Resolution" Style="{StaticResource RowTitle}"/>
                                                        <TextBlock Text="Window size when Minecraft starts" Style="{StaticResource RowDesc}"/>
                                                    </StackPanel>
                                                    <ComboBox x:Name="ResolutionBox" Grid.Column="1" Width="190"
                                                              Style="{StaticResource CB}" SelectedIndex="0"
                                                              SelectionChanged="Settings_ComboChanged"
                                                              PreviewMouseWheel="CB_Wheel">
                                                        <ComboBoxItem Content="Default"/>
                                                        <ComboBoxItem Content="1280 × 720"/>
                                                        <ComboBoxItem Content="1600 × 900"/>
                                                        <ComboBoxItem Content="1920 × 1080"/>
                                                    </ComboBox>
                                                </Grid>
                                            </Border>

                                            <!-- On launch -->
                                            <Border Style="{StaticResource SettingRow}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock Text="When the game opens" Style="{StaticResource RowTitle}"/>
                                                        <TextBlock Text="What happens to the launcher when Minecraft starts" Style="{StaticResource RowDesc}"/>
                                                    </StackPanel>
                                                    <ComboBox x:Name="OnLaunchBox" Grid.Column="1" Width="190"
                                                              Style="{StaticResource CB}" SelectedIndex="0"
                                                              SelectionChanged="Settings_ComboChanged"
                                                              PreviewMouseWheel="CB_Wheel">
                                                        <ComboBoxItem Content="Keep launcher open"/>
                                                        <ComboBoxItem Content="Minimize to taskbar"/>
                                                    </ComboBox>
                                                </Grid>
                                            </Border>

                                            <!-- Discord RPC -->
                                            <Border Style="{StaticResource SettingRow}" BorderThickness="0">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock Text="Discord Rich Presence" Style="{StaticResource RowTitle}"/>
                                                        <TextBlock Text="Show your current game on Discord" Style="{StaticResource RowDesc}"/>
                                                    </StackPanel>
                                                    <CheckBox x:Name="DiscordToggle" Grid.Column="1"
                                                              Style="{StaticResource Toggle}" IsChecked="True"
                                                              VerticalAlignment="Center"
                                                              Checked="DiscordToggle_Changed"
                                                              Unchecked="DiscordToggle_Changed"/>
                                                </Grid>
                                            </Border>
                                        </StackPanel>
                                    </Border>

                                    <!-- JAVA SECTION -->
                                    <TextBlock Text="Java" Foreground="{StaticResource TextMuted}"
                                               FontSize="11" FontWeight="SemiBold" Margin="4,0,0,10"/>
                                    <Border Style="{StaticResource Card}" Padding="0" Margin="0,0,0,18">
                                        <StackPanel>
                                            <!-- Java path -->
                                            <Border Style="{StaticResource SettingRow}">
                                                <StackPanel>
                                                    <TextBlock Text="Java Executable" Style="{StaticResource RowTitle}"/>
                                                    <TextBlock Text="Leave empty for automatic detection"
                                                               Style="{StaticResource RowDesc}" Margin="0,3,0,12"/>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBox x:Name="JavaPathBox" Style="{StaticResource TB}"
                                                                 TextChanged="Settings_TextChanged" Margin="0,0,8,0"/>
                                                        <Button Grid.Column="1" Content="BROWSE"
                                                                Style="{StaticResource BtnSecondary}"
                                                                Click="BrowseJava_Click"/>
                                                    </Grid>
                                                </StackPanel>
                                            </Border>

                                            <!-- JVM args -->
                                            <Border Style="{StaticResource SettingRow}" BorderThickness="0">
                                                <StackPanel>
                                                    <TextBlock Text="Custom JVM Arguments" Style="{StaticResource RowTitle}"/>
                                                    <TextBlock Text="Passed directly to the JVM on launch"
                                                               Style="{StaticResource RowDesc}" Margin="0,3,0,12"/>
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                                        <Button Content="Balanced"   Tag="Balanced"   Style="{StaticResource BtnChip}" Click="JvmPreset_Click"/>
                                                        <Button Content="Performance" Tag="Performance" Style="{StaticResource BtnChip}" Click="JvmPreset_Click"/>
                                                        <Button Content="Max FPS"    Tag="MaxFps"    Style="{StaticResource BtnChip}" Click="JvmPreset_Click"/>
                                                        <Button Content="Clear"      Tag="Clear"     Style="{StaticResource BtnChip}" Click="JvmPreset_Click"/>
                                                    </StackPanel>
                                                    <TextBox x:Name="JavaArgumentsBox" Style="{StaticResource TB}"
                                                             AcceptsReturn="True" TextWrapping="Wrap"
                                                             MinHeight="80" VerticalContentAlignment="Top"
                                                             VerticalScrollBarVisibility="Auto"
                                                             TextChanged="Settings_TextChanged"/>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </Border>

                                    <Button Content="SAVE SETTINGS" Style="{StaticResource BtnPrimary}"
                                            HorizontalAlignment="Stretch" Margin="0,0,0,10"
                                            Click="SaveSettings_Click"/>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>

                        <!-- === ACCOUNT === -->
                        <Grid x:Name="AccountPage" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <StackPanel>
                                <TextBlock Text="Account" Style="{StaticResource PageTitle}"/>
                                <TextBlock Text="Manage your Minecraft authentication." Style="{StaticResource PageSub}"/>
                            </StackPanel>

                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                                        <StackPanel>
                                            <TextBlock Text="CURRENT ACCOUNT" Style="{StaticResource Label}"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                <Border Width="52" Height="52" Background="#0D2040"
                                                        CornerRadius="10" ClipToBounds="True" Margin="0,0,14,0">
                                                    <Image x:Name="AccountAvatar" Stretch="UniformToFill"/>
                                                </Border>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock x:Name="AccountPlayerName" Text="Not logged in"
                                                               Foreground="White" FontSize="16" FontWeight="Bold"/>
                                                    <TextBlock x:Name="AccountStatusDetail" Text="Not logged in"
                                                               Foreground="{StaticResource TextMuted}"
                                                               FontSize="11" Margin="0,4,0,0"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>

                                    <Border Style="{StaticResource Card}">
                                        <StackPanel>
                                            <TextBlock Text="MICROSOFT ACCOUNT" Style="{StaticResource Label}"/>
                                            <TextBlock Text="Sign in with your Microsoft account to use your official Minecraft profile."
                                                       Style="{StaticResource RowDesc}" Margin="0,0,0,14"/>
                                            <Button x:Name="MicrosoftLoginButton"
                                                    Content="LOGIN WITH MICROSOFT"
                                                    Style="{StaticResource BtnPrimary}"
                                                    HorizontalAlignment="Stretch"
                                                    Click="MicrosoftLogin_Click"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <Border Grid.Column="2" Style="{StaticResource Card}" VerticalAlignment="Top">
                                    <StackPanel>
                                        <TextBlock Text="OFFLINE ACCOUNT" Style="{StaticResource Label}"/>
                                        <TextBlock Text="Play without Microsoft authentication using a local name."
                                                   Style="{StaticResource RowDesc}" Margin="0,0,0,14"/>
                                        <TextBlock Text="PLAYER NAME" Style="{StaticResource Label}"/>
                                        <TextBox x:Name="AccountOfflineNameBox" Style="{StaticResource TB}"
                                                 Text="FrostPlayer" MaxLength="16" Margin="0,0,0,12"/>
                                        <Button Content="SAVE OFFLINE ACCOUNT"
                                                Style="{StaticResource BtnSecondary}"
                                                HorizontalAlignment="Stretch"
                                                Click="SaveOfflineName_Click"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Grid>

                    </Grid><!-- /PAGES -->

                    <!-- STATUS BAR -->
                    <Border Grid.Row="2" Background="#EE060D1A"
                            BorderBrush="{StaticResource CardBorder}" BorderThickness="0,1,0,0">
                        <Grid Margin="20,0,10,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse Width="7" Height="7" Fill="#10B981" Margin="0,0,8,0"/>
                                <TextBlock x:Name="StatusText" Text="Ready."
                                           Foreground="{StaticResource TextMuted}"
                                           FontSize="11" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock x:Name="DiscordStatusText"
                                       Text="Discord: connecting…"
                                       Foreground="{StaticResource TextMuted}"
                                       FontSize="9" HorizontalAlignment="Right"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                </Grid>

                <!-- ====== RIGHT RAIL (social links) ====== -->
                <Border Grid.Column="2" Background="{StaticResource SidebarBg}"
                        BorderBrush="{StaticResource CardBorder}" BorderThickness="1,0,0,0">
                    <StackPanel VerticalAlignment="Bottom" HorizontalAlignment="Center"
                                Margin="0,0,0,20">
                        <Button Style="{StaticResource BtnIcon}" Tag="{StaticResource IconDiscord}"
                                ToolTip="Discord" Margin="0,0,0,4" Click="Discord_Click"/>
                        <Button Style="{StaticResource BtnIcon}" Tag="{StaticResource IconWeb}"
                                ToolTip="Website" Margin="0,0,0,4" Click="Website_Click"/>
                        <Button Style="{StaticResource BtnIcon}" Tag="{StaticResource IconYT}"
                                ToolTip="YouTube" Margin="0,0,0,4" Click="YouTube_Click"/>
                        <Button Style="{StaticResource BtnIcon}" Tag="{StaticResource IconGH}"
                                ToolTip="GitHub" Click="GitHub_Click"/>
                    </StackPanel>
                </Border>

            </Grid><!-- /MAIN UI -->

            <!-- ====== SETUP WIZARD ====== -->
            <Grid x:Name="WizardOverlay" Panel.ZIndex="100" Visibility="Collapsed" Background="#EE04090F">

                <Grid x:Name="WizardScreen_Welcome" Visibility="Collapsed">
                    <Border Width="500" Padding="36" Background="#F00A1528" BorderBrush="#1C3358"
                            BorderThickness="1" CornerRadius="18" HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                        <StackPanel>
                            <Border Width="64" Height="64" CornerRadius="14" Background="#0D2040"
                                    HorizontalAlignment="Center" Margin="0,0,0,18">
                                <TextBlock Text="❄" FontSize="36" Foreground="#60A5FA"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Welcome to Frost Client" Foreground="White" FontSize="24"
                                       FontWeight="Bold" HorizontalAlignment="Center"/>
                            <TextBlock Text="Let's get your launcher ready." Foreground="{StaticResource TextMuted}"
                                       FontSize="12" HorizontalAlignment="Center" Margin="0,8,0,24"/>
                            <Border Background="#0A1428" CornerRadius="10" Padding="16" Margin="0,0,0,22">
                                <StackPanel>
                                    <TextBlock Text="QUICK SETUP" Foreground="#60A5FA" FontWeight="Bold"
                                               FontSize="10" Margin="0,0,0,10"/>
                                    <TextBlock Text="1. Configure your Java installation."
                                               Foreground="White" FontSize="11" Margin="0,0,0,7"/>
                                    <TextBlock Text="2. Choose your account."
                                               Foreground="White" FontSize="11" Margin="0,0,0,7"/>
                                    <TextBlock Text="3. Start playing Minecraft."
                                               Foreground="White" FontSize="11"/>
                                </StackPanel>
                            </Border>
                            <Button Content="GET STARTED" Style="{StaticResource BtnPrimary}"
                                    HorizontalAlignment="Stretch" Click="Wizard_Step1_Next_Click"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <Grid x:Name="WizardScreen_Java" Visibility="Collapsed">
                    <Border Width="520" Padding="36" Background="#F00A1528" BorderBrush="#1C3358"
                            BorderThickness="1" CornerRadius="18" HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                        <StackPanel>
                            <TextBlock Text="Java Configuration" FontSize="22" FontWeight="Bold" Foreground="White"/>
                            <TextBlock Text="Select the Java executable used to launch Minecraft."
                                       Foreground="{StaticResource TextMuted}" FontSize="11"
                                       TextWrapping="Wrap" Margin="0,7,0,24"/>
                            <TextBlock Text="JAVA EXECUTABLE" Style="{StaticResource Label}"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="WizardJavaPathBox" Style="{StaticResource TB}" Margin="0,0,8,0"/>
                                <Button Grid.Column="1" Content="BROWSE" Style="{StaticResource BtnSecondary}"
                                        Click="Wizard_BrowseJava_Click"/>
                            </Grid>
                            <TextBlock Text="Leave empty for automatic Java detection."
                                       Foreground="{StaticResource TextMuted}" FontSize="10"
                                       TextWrapping="Wrap" Margin="0,9,0,26"/>
                            <Grid>
                                <Button Content="BACK" Style="{StaticResource BtnSecondary}"
                                        HorizontalAlignment="Left" Click="Wizard_Step2_Back_Click"/>
                                <Button Content="CONTINUE" Style="{StaticResource BtnPrimary}"
                                        HorizontalAlignment="Right" Click="Wizard_Step2_Next_Click"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>

                <Grid x:Name="WizardScreen_Login" Visibility="Collapsed">
                    <Border Width="520" Padding="36" Background="#F00A1528" BorderBrush="#1C3358"
                            BorderThickness="1" CornerRadius="18" HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                        <StackPanel>
                            <TextBlock Text="Choose Your Account" FontSize="22" FontWeight="Bold" Foreground="White"/>
                            <TextBlock Text="How do you want to authenticate with Frost Client?"
                                       Foreground="{StaticResource TextMuted}" FontSize="11"
                                       TextWrapping="Wrap" Margin="0,7,0,24"/>
                            <Border Background="#0A1428" CornerRadius="10" Padding="18" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="MICROSOFT ACCOUNT" Foreground="White"
                                               FontWeight="Bold" FontSize="11" Margin="0,0,0,8"/>
                                    <TextBlock Text="Sign in with your official Minecraft account."
                                               Foreground="{StaticResource TextMuted}" FontSize="10" Margin="0,0,0,14"/>
                                    <Button Content="LOGIN WITH MICROSOFT" Style="{StaticResource BtnPrimary}"
                                            HorizontalAlignment="Stretch"
                                            Click="Wizard_LoginMicrosoft_Click"/>
                                </StackPanel>
                            </Border>
                            <Border Background="#0A1428" CornerRadius="10" Padding="18" Margin="0,0,0,20">
                                <StackPanel>
                                    <TextBlock Text="OFFLINE ACCOUNT" Foreground="White"
                                               FontWeight="Bold" FontSize="11" Margin="0,0,0,8"/>
                                    <TextBlock Text="Enter a local username (no Microsoft needed)."
                                               Foreground="{StaticResource TextMuted}" FontSize="10" Margin="0,0,0,12"/>
                                    <TextBox x:Name="UsernameBox" Style="{StaticResource TB}"
                                             Text="FrostPlayer" MaxLength="16" Margin="0,0,0,12"/>
                                    <Button Content="CONTINUE OFFLINE" Style="{StaticResource BtnSecondary}"
                                            HorizontalAlignment="Stretch"
                                            Click="Wizard_LoginOffline_Click"/>
                                </StackPanel>
                            </Border>
                            <Button Content="BACK" Style="{StaticResource BtnSecondary}"
                                    HorizontalAlignment="Left" Click="Wizard_Step4_Back_Click"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>

            <!-- ====== RENAME OVERLAY ====== -->
            <Grid x:Name="RenameOverlay" Panel.ZIndex="200" Visibility="Collapsed"
                  Background="#BB04090F">
                <Border Width="440" Padding="30" Background="#F00A1528" BorderBrush="#1C3358"
                        BorderThickness="1" CornerRadius="14" HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                    <StackPanel>
                        <TextBlock Text="Rename Version" Foreground="White" FontSize="18"
                                   FontWeight="Bold" Margin="0,0,0,6"/>
                        <TextBlock x:Name="RenameSubText"
                                   Text="Enter a display name for this version."
                                   Foreground="{StaticResource TextMuted}" FontSize="11"
                                   TextWrapping="Wrap" Margin="0,0,0,18"/>
                        <TextBlock Text="DISPLAY NAME" Style="{StaticResource Label}"/>
                        <TextBox x:Name="RenameBox" Style="{StaticResource TB}" MaxLength="50" Margin="0,0,0,20"
                                 KeyDown="RenameBox_KeyDown"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="CANCEL" Style="{StaticResource BtnSecondary}"
                                    Margin="0,0,10,0" Click="RenameCancel_Click"/>
                            <Button Content="SAVE" Style="{StaticResource BtnPrimary}"
                                    MinWidth="90" Click="RenameSave_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

        </Grid>
    </Border>
</Window>