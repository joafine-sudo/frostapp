        <Geometry x:Key="IconFolder">M3,5 H10 L12,7 H21 V19 H3 Z</Geometry>
        <Geometry x:Key="IconVersions">M4,2 H20 V7 H4 Z M4,10 H20 V15 H4 Z M4,18 H20 V23 H4 Z</Geometry>
