<Window x:Class="FrostClient.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Frost Client"
        Width="1120" Height="700"
        MinWidth="900" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Loaded="Window_Loaded">

    <Window.Resources>
        <!-- COLOURS -->
        <SolidColorBrush x:Key="TextMuted"   Color="#7B90B8"/>
        <SolidColorBrush x:Key="CardBg"      Color="#CC0D1A2E"/>
        <SolidColorBrush x:Key="CardBorder"  Color="#1C3358"/>
        <SolidColorBrush x:Key="SidebarBg"   Color="#EA080F1E"/>
        <SolidColorBrush x:Key="AccentBlue"  Color="#3B82F6"/>

        <LinearGradientBrush x:Key="PlayGrad" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#60A5FA" Offset="0"/>
            <GradientStop Color="#2563EB" Offset="1"/>
        </LinearGradientBrush>

        <!-- Snow flake geometry used as floating decoration -->
        <Geometry x:Key="IconClose">M5,5 L19,19 M19,5 L5,19</Geometry>
        <Geometry x:Key="IconMin">M4,12 H20</Geometry>
        <Geometry x:Key="IconPlay">M8,5 L19,12 L8,19 Z</Geometry>
        <Geometry x:Key="IconVersions">M4,2 H20 V7 H4 Z M4,10 H20 V15 H4 Z M4,18 H20 V23 H4 Z</Geometry>
