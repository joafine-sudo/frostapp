        <Geometry x:Key="IconYoutube">M21.58,7.19 C21.35,6.31 20.66,5.62 19.78,5.39 C18.18,4.96 12,4.96 12,4.96 C12,4.96 5.82,4.96 4.22,5.39 C3.34,5.62 2.65,6.31 2.42,7.19 C2,8.79 2,12.14 2,12.14 C2,12.14 2,15.49 2.42,17.09 C2.65,17.97 3.34,18.66 4.22,18.89 C5.82,19.32 12,19.32 12,19.32 C12,19.32 18.18,19.32 19.78,18.89 C20.66,18.66 21.35,17.97 21.58,17.09 C22,15.49 22,12.14 22,12.14 C22,12.14 22,8.79 21.58,7.19 Z M10,15.19 V9.09 L15.2,12.14 L10,15.19 Z</Geometry>
        <Geometry x:Key="IconPaypal">M5,3 H14 C18,3 20,5 20,8.5 C20,12.5 17.2,15 13.3,15 H10.5 L9.5,21 H5.8 L7.1,13 H4 L4.7,9 H7.8 Z M10,6.5 L9.2,11.5 H13 C15,11.5 16.2,10.4 16.2,8.6 C16.2,7.2 15.2,6.5 13.5,6.5 Z</Geometry>

        <!-- TOOLTIP (required with AllowsTransparency to avoid an empty white box) -->
        <Style TargetType="{x:Type ToolTip}">
            <Setter Property="Background" Value="#0A0A0A"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#333333"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="9,6"/>
            <Setter Property="HasDropShadow" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ToolTip}">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}"
                                              TextElement.FontSize="{TemplateBinding FontSize}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- THIN SCROLLBAR -->
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="6"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border Background="#444444" CornerRadius="3" Margin="1"/>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- TEXT -->
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
            <Setter Property="Margin" Value="0,0,0,7"/>
        </Style>
        <Style x:Key="RowTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style x:Key="RowDesc" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
            <Setter Property="Margin" Value="0,3,0,10"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <!-- DARK PANEL (thick pixel-style borders) -->
        <Style x:Key="Panel" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PanelBg}"/>
            <Setter Property="BorderBrush" Value="{StaticResource PanelEdge}"/>
            <Setter Property="BorderThickness" Value="3"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="20"/>
        </Style>
        <Style x:Key="VersionCard" TargetType="Border">
            <Setter Property="Background" Value="#262626"/>
            <Setter Property="BorderBrush" Value="#0A0A0A"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <!-- TEXTBOX -->
        <Style x:Key="TB" TargetType="TextBox">
            <Setter Property="Background" Value="#0F0F0F"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#333333"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="CaretBrush" Value="White"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- COMBOBOX -->
        <Style x:Key="CBI" TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="12,9"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}" CornerRadius="3" Margin="3,1">
                            <ContentPresenter TextElement.Foreground="White"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#333333"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#3E6FD0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CB" TargetType="ComboBox">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource CBI}"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Focusable="False" ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Bd" Background="#0F0F0F" BorderBrush="#333333"
                                                BorderThickness="2" CornerRadius="4">
                                            <Path HorizontalAlignment="Right" VerticalAlignment="Center"
                                                  Margin="0,0,13,0" Fill="#9AA3B5" Data="M0,0 L4,4 L8,0 Z"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="BorderBrush" Value="#6FD64A"/>
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Bd" Property="BorderBrush" Value="#6FD64A"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              Margin="14,0,34,0" VerticalAlignment="Center"
                                              TextElement.Foreground="White"/>
                            <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Top"
                                   AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
                                <Grid Width="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                      MaxHeight="260" SnapsToDevicePixels="True">
                                    <Border Background="#121212" BorderBrush="#333333" BorderThickness="2"
                                            CornerRadius="4" Margin="0,0,0,4">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,4">
                                            <StackPanel IsItemsHost="True"
                                                        KeyboardNavigation.DirectionalNavigation="Contained"/>
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- BOTÕES -->
        <Style x:Key="BtnPlay" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="4" BorderBrush="#1B5A12" BorderThickness="3">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#74DB4E" Offset="0"/>
                                    <GradientStop Color="#45B02E" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.92"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BtnPrimary" TargetType="Button">
            <Setter Property="Foreground" Value="#14400C"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="#5BC83E" BorderBrush="#1B5A12" BorderThickness="2"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#74DB4E"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BtnSecondary" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="#2C2C2C" BorderBrush="#0A0A0A" BorderThickness="2"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#3A3A3A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BtnDiscord" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="#5865F2" BorderBrush="#2F37A0" BorderThickness="2"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#7280FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Botões da barra de título (min / fechar) — o ícone vem do Tag -->
        <Style x:Key="BtnChrome" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="4">
                            <Path Data="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
                                  Stroke="{TemplateBinding Foreground}" StrokeThickness="1.8"
                                  Width="12" Height="12" Stretch="Uniform"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#333333"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Botão quadrado escuro com ícone (engrenagem) -->
        <Style x:Key="BtnSquare" TargetType="Button">
            <Setter Property="Width" Value="48"/>
            <Setter Property="Height" Value="48"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="#1B1B1B" BorderBrush="#0A0A0A" BorderThickness="3" CornerRadius="4">
                            <Path x:Name="Ic" Data="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
                                  Fill="#C8CCD6" Width="20" Height="20" Stretch="Uniform"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2A2A2A"/>
                                <Setter TargetName="Ic" Property="Fill" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Lixo (remover conta) — o Id da conta vai no Tag -->
        <Style x:Key="BtnTrash" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="4" Width="32" Height="32">
                            <Path Data="{StaticResource IconDelete}" Fill="#EF4444"
                                  Width="14" Height="14" Stretch="Uniform"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#3A1212"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Lápis (renomear versão) — o RealId vai no Tag -->
        <Style x:Key="BtnEdit" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="4" Width="32" Height="32">
                            <Path x:Name="Ic" Data="{StaticResource IconEdit}" Fill="#9AA3B5"
                                  Width="14" Height="14" Stretch="Uniform"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#333333"/>
                                <Setter TargetName="Ic" Property="Fill" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Interruptor -->
        <Style x:Key="Toggle" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="Tr" Width="44" Height="24" CornerRadius="12" Background="#333333">
                            <Ellipse x:Name="Kn" Width="18" Height="18" Fill="White"
                                     HorizontalAlignment="Left" Margin="3,0,0,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Tr" Property="Background" Value="#5BC83E"/>
                                <Setter TargetName="Kn" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="Kn" Property="Margin" Value="0,0,3,0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Chip (presets JVM) -->
        <Style x:Key="BtnChip" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="#0F0F0F" BorderBrush="#333333" BorderThickness="2"
                                CornerRadius="4" Padding="12,5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#6FD64A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Cartão lateral esquerdo (estilo Shop / My skin) -->
        <Style x:Key="HomeTile" TargetType="Button">
            <Setter Property="Width" Value="140"/>
            <Setter Property="Height" Value="84"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="#0A0A0A" BorderThickness="3" CornerRadius="4" Padding="10,8">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.88"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Atalho compacto (só ícone, estilo minimalista) -->
        <Style x:Key="SocialIcon" TargetType="Button">
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="#99111111" BorderBrush="#0A0A0A"
                                BorderThickness="2" CornerRadius="4">
                            <Path x:Name="Ic" Data="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
                                  Fill="White" Opacity="0.75" Width="16" Height="16" Stretch="Uniform"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="White"/>
                                <Setter TargetName="Bd" Property="Background" Value="#CC1E1E1E"/>
                                <Setter TargetName="Ic" Property="Opacity" Value="1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- ====================== ROOT ====================== -->
    <Border CornerRadius="10" Background="#0F2A12" BorderBrush="#0A0A0A" BorderThickness="1" ClipToBounds="True">
        <Grid>
            <!-- Fundo verde (predefinido) -->
            <Rectangle x:Name="GreenBg">
                <Rectangle.Fill>
                    <RadialGradientBrush Center="0.5,0.45" RadiusX="0.75" RadiusY="0.85">
                        <GradientStop Color="#58B040" Offset="0"/>
                        <GradientStop Color="#2F7A2B" Offset="0.55"/>
                        <GradientStop Color="#15451A" Offset="1"/>
                    </RadialGradientBrush>
                </Rectangle.Fill>
            </Rectangle>

            <!-- Fundo com imagem (quando escolhida nas definições) -->
            <Rectangle x:Name="WallpaperRect" Visibility="Collapsed">
                <Rectangle.Fill>
                    <ImageBrush x:Name="BackgroundImageBrush" Stretch="UniformToFill"/>
                </Rectangle.Fill>
            </Rectangle>
            <Rectangle x:Name="WallpaperShade" Visibility="Collapsed">
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#22000000" Offset="0"/>
                        <GradientStop Color="#88000000" Offset="1"/>
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>

            <!-- =================== ECRÃ ÚNICO =================== -->
            <Grid x:Name="MainLauncherUI">
                <Grid.RowDefinitions>
                    <RowDefinition Height="40"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- BARRA DE TÍTULO -->
                <Grid Grid.Row="0" Background="#F0111111" MouseLeftButtonDown="TopBar_MouseLeftButtonDown">
                    <TextBlock x:Name="StatusText" Text="" FontSize="10"
                               Foreground="{StaticResource TextMuted}"
                               VerticalAlignment="Center" Margin="16,0,0,0"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="" FontSize="16" Foreground="#9BD7FF" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="FROST CLIENT" FontSize="12" FontWeight="Black"
                                   Foreground="White" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0">
                        <Button Style="{StaticResource BtnChrome}" Tag="{StaticResource IconMin}" Click="Minimize_Click"/>
                        <Button Style="{StaticResource BtnChrome}" Tag="{StaticResource IconClose}" Click="Close_Click"/>
                    </StackPanel>
                </Grid>

                <!-- CONTEÚDO -->
                <Grid Grid.Row="1" Margin="22,20,22,22">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- ESQUERDA: atalhos -->
                    <StackPanel Grid.RowSpan="2" HorizontalAlignment="Left" VerticalAlignment="Top">
                        <Button Style="{StaticResource SocialIcon}" Click="Website_Click" ToolTip="Website" Tag="{StaticResource IconWeb}"/>
                        <Button Style="{StaticResource SocialIcon}" Click="Github_Click" ToolTip="GitHub" Tag="{StaticResource IconGithub}"/>
                        <Button Style="{StaticResource SocialIcon}" Click="Youtube_Click" ToolTip="YouTube" Tag="{StaticResource IconYoutube}"/>
                        <Button Style="{StaticResource SocialIcon}" Click="Paypal_Click" ToolTip="PayPal" Tag="{StaticResource IconPaypal}"/>
                    </StackPanel>

                    <!-- TOPO DIREITA: conta + definições -->
                    <StackPanel Grid.RowSpan="2" Orientation="Horizontal"
                                HorizontalAlignment="Right" VerticalAlignment="Top">
                        <Button Cursor="Hand" Focusable="False" Click="OpenAccount_Click" Margin="0,0,10,0">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bd" Background="#1B1B1B" BorderBrush="#0A0A0A"
                                            BorderThickness="3" CornerRadius="4" Padding="8,0,14,0"
                                            Height="48" MinWidth="190">
                                        <ContentPresenter VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#2A2A2A"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                            <StackPanel Orientation="Horizontal">
                                <Border Width="32" Height="32" CornerRadius="3" Background="#0F0F0F"
                                        ClipToBounds="True" Margin="0,0,10,0">
                                    <Grid>
                                        <TextBlock Text="❄" FontSize="15" Foreground="#555555"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        <Image x:Name="TopPlayerAvatar" Stretch="UniformToFill"
                                               RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                                    </Grid>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock x:Name="TopPlayerName"
                                               Text="{Binding [not_logged_in], Source={x:Static loc:Loc.Instance}}"
                                               FontSize="13" FontWeight="Black" Foreground="White"/>
                                    <TextBlock x:Name="TopPlayerType" Text="" FontSize="9" Foreground="#9AA3B5"/>
                                </StackPanel>
                                <Path Data="M0,0 L4,4 L8,0 Z" Fill="#9AA3B5" Width="8" Height="5"
                                      Stretch="Uniform" Margin="14,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource BtnSquare}" Tag="{StaticResource IconSettings}"
                                ToolTip="{Binding [nav_settings], Source={x:Static loc:Loc.Instance}}"
                                Click="OpenSettings_Click"/>
                    </StackPanel>

                    <!-- DIREITA: Discord -->
                    <Border Grid.Row="0" HorizontalAlignment="Right" VerticalAlignment="Center"
                            Width="270" Background="#3438A8" BorderBrush="#0A0A0A"
                            BorderThickness="3" CornerRadius="4" Padding="18" Margin="0,40,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding [join_discord], Source={x:Static loc:Loc.Instance}}"
                                           FontSize="20" FontWeight="Black" Foreground="White" TextWrapping="Wrap"/>
                                <TextBlock Text="+800 members now" FontSize="12" FontWeight="SemiBold"
                                           Foreground="#CFD6F5" Margin="0,4,0,0"/>
                                <Button Style="{StaticResource BtnDiscord}" HorizontalAlignment="Left"
                                        Margin="0,14,0,0" Click="Discord_Click"
                                        ToolTip="{Binding [join_discord_tip], Source={x:Static loc:Loc.Instance}}">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource IconPlay}" Fill="White" Width="10" Height="10"
                                              Stretch="Uniform" Margin="0,0,7,0"/>
                                        <TextBlock Text="Discord" FontSize="11"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                            <Path Grid.Column="1" Data="{StaticResource IconDiscord}" Fill="White"
                                  Width="54" Height="54" Stretch="Uniform" VerticalAlignment="Center"
                                  Margin="10,0,0,0"/>
                        </Grid>
                    </Border>

                    <!-- BASE: versão + JOGAR -->
                    <Grid Grid.Row="1" HorizontalAlignment="Center" Width="720" Height="92">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="250"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Background="#2B5DB5" BorderBrush="#0A0A0A"
                                BorderThickness="3" CornerRadius="4" Padding="12,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Button Style="{StaticResource BtnSquare}" Width="60" Height="60"
                                        Tag="{StaticResource IconVersions}" VerticalAlignment="Center"
                                        Click="OpenVersions_Click"
                                        ToolTip="{Binding [nav_versions], Source={x:Static loc:Loc.Instance}}"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="14,0,0,0">
                                    <TextBlock Text="READY TO PLAY" FontSize="9" FontWeight="Bold" Foreground="#BBD7F7"/>
                                    <ComboBox x:Name="VersionBox" Style="{StaticResource CB}"
                                              DisplayMemberPath="DisplayName"
                                              SelectionChanged="Version_Changed"
                                              MinHeight="32" FontSize="13" Margin="0,3,0,0"/>
                                    <TextBlock x:Name="HomeVersionLabel" Text="" FontSize="9"
                                               Foreground="#C6D8EE" Margin="2,4,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Button x:Name="PlayButton" Grid.Column="2" Style="{StaticResource BtnPlay}"
                                Click="Play_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="PlayText"
                                           Text="{Binding [play], Source={x:Static loc:Loc.Instance}}"
                                           FontSize="30" FontWeight="Black" Foreground="#14400C"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Grid>
            </Grid>

            <!-- ====== DEFINIÇÕES ====== -->
            <Grid x:Name="SettingsOverlay" Panel.ZIndex="100" Visibility="Collapsed" Background="#CC000000">
                <Border Style="{StaticResource Panel}" Width="560" MaxHeight="620"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid Margin="0,0,0,14">
                            <TextBlock Text="{Binding [nav_settings], Source={x:Static loc:Loc.Instance}}"
                                       FontSize="20" FontWeight="Black" Foreground="White" VerticalAlignment="Center"/>
                            <Button Style="{StaticResource BtnChrome}" Tag="{StaticResource IconClose}"
                                    HorizontalAlignment="Right" Click="CloseSettings_Click"/>
                        </Grid>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="0,0,12,0">
                                <TextBlock Text="{Binding [language], Source={x:Static loc:Loc.Instance}}" Style="{StaticResource RowTitle}"/>
                                <TextBlock Text="{Binding [language_desc], Source={x:Static loc:Loc.Instance}}" Style="{StaticResource RowDesc}"/>
                                <ComboBox x:Name="LanguageBox" Style="{StaticResource CB}" Margin="0,0,0,20"
                                          SelectionChanged="Language_Changed">
                                    <ComboBoxItem Content="English" Tag="en-GB"/>
<ComboBoxItem Content="Português" Tag="pt-PT"/>
<ComboBoxItem Content="Español" Tag="es-ES"/>
<ComboBoxItem Content="Français" Tag="fr-FR"/>
<ComboBoxItem Content="Русский" Tag="ru-RU"/>
<ComboBoxItem Content="ไทย" Tag="th-TH"/>
                                </ComboBox>

                                <TextBlock Text="{Binding [bg], Source={x:Static loc:Loc.Instance}}" Style="{StaticResource RowTitle}"/>
                                <TextBlock Text="{Binding [bg_desc], Source={x:Static loc:Loc.Instance}}" Style="{StaticResource RowDesc}"/>
                                <ComboBox x:Name="WallpaperBox" Style="{StaticResource CB}" Margin="0,0,0,20"
                                          SelectionChanged="Wallpaper_Changed">
                                                                        <ComboBoxItem Content="{Binding [wp_default], Source={x:Static loc:Loc.Instance}}" Tag="default.png"/>
                                    <ComboBoxItem Content="{Binding [wp_iceland], Source={x:Static loc:Loc.Instance}}" Tag="iceland.jpg"/>
                                    <ComboBoxItem Content="{Binding [wp_house], Source={x:Static loc:Loc.Instance}}" Tag="house.jpg"/>
                                    <ComboBoxItem Content="{Binding [wp_fox], Source={x:Static loc:Loc.Instance}}" Tag="fox.jpg"/>
                                </ComboBox>

                                <TextBlock Text="{Binding [ram], Source={x:Static loc:Loc.Instance}}" Style="{StaticResource RowTitle}"/>
                                <TextBlock Text="{Binding [ram_desc], Source={x:Static loc:Loc.Instance}}" Style="{StaticResource RowDesc}"/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                                    <Slider x:Name="RamSlider" Width="380" Minimum="1" Maximum="16" Value="4"
                                            TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center"
                                            ValueChanged="RamSlider_Changed"/>
                                    <TextBlock x:Name="RamLabel" Text="4 GB" Width="70" Foreground="White"
                                               FontWeight="Bold" FontSize="14" TextAlignment="Right" VerticalAlignment="Center"/>
                                </StackPanel>

                                <TextBlock Text="{Binding [res], Source={x:Static loc:Loc.Instance}}" Style="{StaticResource RowTitle}"/>
                                <TextBlock Text="{Binding [res_desc], Source={x:Static loc:Loc.Instance}}" Style="{StaticResource RowDesc}"/>
                                <ComboBox x:Name="ResolutionBox" Style="{StaticResource CB}" Margin="0,0,0,20"
                                          SelectionChanged="Settings_ComboChanged">
                                    <ComboBoxItem Content="{Binding [res_default], Source={x:Static loc:Loc.Instance}}"/>
                                    <ComboBoxItem Content="1280 × 720"/>
                                    <ComboBoxItem Content="1600 × 900"/>
                                    <ComboBoxItem Content="1920 × 1080"/>
                                </ComboBox>

                                <TextBlock Text="{Binding [on_open], Source={x:Static loc:Loc.Instance}}" Style="{StaticResource RowTitle}"/>
                                <TextBlock Text="{Binding [on_open_desc], Source={x:Static loc:Loc.Instance}}" Style="{StaticResource RowDesc}"/>
                                <ComboBox x:Name="OnLaunchBox" Style="{StaticResource CB}" Margin="0,0,0,20"
                                          SelectionChanged="Settings_ComboChanged">
                                    <ComboBoxItem Content="{Binding [keep_open], Source={x:Static loc:Loc.Instance}}"/>
                                    <ComboBoxItem Content="{Binding [minimize], Source={x:Static loc:Loc.Instance}}"/>
                                </ComboBox>

                                <Grid Margin="0,0,0,20">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Discord Rich Presence" Style="{StaticResource RowTitle}"/>
                                        <TextBlock Text="{Binding [discord_rpc_desc], Source={x:Static loc:Loc.Instance}}"
                                                   Style="{StaticResource RowDesc}" Margin="0,3,0,0"/>
                                    </StackPanel>
                                    <CheckBox x:Name="DiscordToggle" Grid.Column="1" Style="{StaticResource Toggle}"
                                              IsChecked="True" VerticalAlignment="Center"
                                              Checked="DiscordToggle_Changed" Unchecked="DiscordToggle_Changed"/>
                                </Grid>

                                <TextBlock Text="{Binding [java_exe], Source={x:Static loc:Loc.Instance}}" Style="{StaticResource RowTitle}"/>
                                <TextBlock Text="{Binding [java_exe_desc], Source={x:Static loc:Loc.Instance}}" Style="{StaticResource RowDesc}"/>
                                <Grid Margin="0,0,0,20">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="JavaPathBox" Style="{StaticResource TB}" Margin="0,0,8,0"
                                             TextChanged="Settings_TextChanged"/>
                                    <Button Grid.Column="1" Content="{Binding [browse], Source={x:Static loc:Loc.Instance}}"
                                            Style="{StaticResource BtnSecondary}" Click="BrowseJava_Click"/>
                                </Grid>

                                <TextBlock Text="{Binding [jvm_args], Source={x:Static loc:Loc.Instance}}" Style="{StaticResource RowTitle}"/>
                                <TextBlock Text="{Binding [jvm_args_desc], Source={x:Static loc:Loc.Instance}}" Style="{StaticResource RowDesc}"/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <Button Content="{Binding [preset_balanced], Source={x:Static loc:Loc.Instance}}" Tag="Balanced" Style="{StaticResource BtnChip}" Click="JvmPreset_Click"/>
                                    <Button Content="{Binding [preset_perf], Source={x:Static loc:Loc.Instance}}" Tag="Performance" Style="{StaticResource BtnChip}" Click="JvmPreset_Click"/>
                                    <Button Content="{Binding [preset_maxfps], Source={x:Static loc:Loc.Instance}}" Tag="MaxFps" Style="{StaticResource BtnChip}" Click="JvmPreset_Click"/>
                                    <Button Content="{Binding [preset_clear], Source={x:Static loc:Loc.Instance}}" Tag="Clear" Style="{StaticResource BtnChip}" Click="JvmPreset_Click"/>
                                </StackPanel>
                                <TextBox x:Name="JavaArgumentsBox" Style="{StaticResource TB}" AcceptsReturn="True"
                                         TextWrapping="Wrap" MinHeight="70" VerticalContentAlignment="Top"
                                         VerticalScrollBarVisibility="Auto" TextChanged="Settings_TextChanged"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>

            <!-- ====== VERSÕES ====== -->
            <Grid x:Name="VersionsOverlay" Panel.ZIndex="105" Visibility="Collapsed" Background="#CC000000">
                <Border Style="{StaticResource Panel}" Width="780" Height="520"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="{Binding [nav_versions], Source={x:Static loc:Loc.Instance}}"
                                           FontSize="20" FontWeight="Black" Foreground="White"/>
                                <TextBlock Text="{Binding [versions_sub], Source={x:Static loc:Loc.Instance}}"
                                           FontSize="11" Foreground="{StaticResource TextMuted}" Margin="0,3,0,0"/>
                            </StackPanel>
                            <Button Style="{StaticResource BtnChrome}" Tag="{StaticResource IconClose}"
                                    HorizontalAlignment="Right" VerticalAlignment="Top" Click="CloseVersions_Click"/>
                        </Grid>

                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="270"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Instalar nova versão -->
                            <StackPanel VerticalAlignment="Top">
                                <TextBlock Text="{Binding [install_new], Source={x:Static loc:Loc.Instance}}"
                                           Style="{StaticResource Label}" Margin="0,0,0,12"/>
                                <TextBlock Text="{Binding [mc_version], Source={x:Static loc:Loc.Instance}}" Style="{StaticResource Label}"/>
                                <ComboBox x:Name="InstallVersionBox" Style="{StaticResource CB}" Margin="0,0,0,14"/>
                                <Button x:Name="InstallButton" Style="{StaticResource BtnPrimary}" Margin="0,0,0,12"
                                        Content="{Binding [download_install], Source={x:Static loc:Loc.Instance}}"
                                        Click="InstallVersion_Click"/>
                                <ProgressBar x:Name="InstallProgress" Height="6" Visibility="Collapsed"
                                             IsIndeterminate="True" Foreground="#5BC83E" Background="#0F0F0F"
                                             BorderThickness="0" Margin="0,0,0,10"/>
                                <Border Background="#0F0F0F" CornerRadius="4" Padding="12">
                                    <TextBlock x:Name="InstallStatusText" FontSize="10" TextWrapping="Wrap"
                                               Foreground="{StaticResource TextMuted}"
                                               Text="{Binding [waiting_install], Source={x:Static loc:Loc.Instance}}"/>
                                </Border>
                            </StackPanel>

                            <!-- Versões instaladas -->
                            <Grid Grid.Column="2">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Grid Margin="0,0,0,10">
                                    <TextBlock Text="{Binding [installed_versions], Source={x:Static loc:Loc.Instance}}"
                                               Style="{StaticResource Label}" VerticalAlignment="Center" Margin="0"/>
                                    <Button Content="{Binding [refresh], Source={x:Static loc:Loc.Instance}}"
                                            Style="{StaticResource BtnSecondary}" HorizontalAlignment="Right"
                                            Padding="12,6" Click="RefreshVersions_Click"/>
                                </Grid>
                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                    <ItemsControl x:Name="VersionList">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Style="{StaticResource VersionCard}">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Border Width="36" Height="36" CornerRadius="4" Background="#2B5DB5"
                                                                Margin="0,0,12,0">
                                                            <TextBlock Text="{Binding Letter}" Foreground="White"
                                                                       FontWeight="Black" FontSize="13"
                                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding DisplayName}" Foreground="White"
                                                                       FontWeight="SemiBold" FontSize="13"
                                                                       TextTrimming="CharacterEllipsis"/>
                                                            <TextBlock Text="{Binding RealId}"
                                                                       Foreground="{StaticResource TextMuted}"
                                                                       FontSize="10" Margin="0,2,0,0"
                                                                       TextTrimming="CharacterEllipsis"/>
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                            <Button Tag="{Binding RealId}"
                                                                    Content="{Binding [select], Source={x:Static loc:Loc.Instance}}"
                                                                    Style="{StaticResource BtnSecondary}" Padding="12,6"
                                                                    FontSize="10" Margin="0,0,6,0" Click="SelectVersion_Click"/>
                                                            <Button Tag="{Binding RealId}" Style="{StaticResource BtnEdit}"
                                                                    ToolTip="{Binding [rename], Source={x:Static loc:Loc.Instance}}"
                                                                    Click="RenameVersionFromList_Click"/>
                                                            <Button Tag="{Binding RealId}" Style="{StaticResource BtnTrash}"
                                                                    ToolTip="{Binding [delete], Source={x:Static loc:Loc.Instance}}"
                                                                    Click="DeleteVersion_Click"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <!-- ====== RENOMEAR VERSÃO ====== -->
            <Grid x:Name="RenameOverlay" Panel.ZIndex="240" Visibility="Collapsed" Background="#CC000000">
                <Border Style="{StaticResource Panel}" Width="440" Padding="26"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
                    <StackPanel>
                        <TextBlock x:Name="RenameTitle" Text="{Binding [rename_version], Source={x:Static loc:Loc.Instance}}"
                                   Foreground="White" FontSize="18" FontWeight="Bold" Margin="0,0,0,6"/>
                        <TextBlock x:Name="RenameSubText" Text="{Binding [rename_desc], Source={x:Static loc:Loc.Instance}}"
                                   Foreground="{StaticResource TextMuted}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,18"/>
                        <TextBlock x:Name="RenameLabel" Text="{Binding [display_name], Source={x:Static loc:Loc.Instance}}"
                                   Style="{StaticResource Label}"/>
                        <TextBox x:Name="RenameBox" Style="{StaticResource TB}" MaxLength="50" Margin="0,0,0,20"
                                 KeyDown="RenameBox_KeyDown"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="{Binding [cancel], Source={x:Static loc:Loc.Instance}}"
                                    Style="{StaticResource BtnSecondary}" Margin="0,0,10,0" Click="RenameCancel_Click"/>
                            <Button Content="{Binding [save], Source={x:Static loc:Loc.Instance}}"
                                    Style="{StaticResource BtnPrimary}" MinWidth="90" Click="RenameSave_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ====== CONTAS ====== -->
            <Grid x:Name="AccountOverlay" Panel.ZIndex="110" Visibility="Collapsed" Background="#CC000000">
                <Border Style="{StaticResource Panel}" Width="520" MaxHeight="600"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="0,0,8,0">
                            <Grid Margin="0,0,0,16">
                                <TextBlock Text="{Binding [nav_accounts], Source={x:Static loc:Loc.Instance}}"
                                           FontSize="20" FontWeight="Black" Foreground="White" VerticalAlignment="Center"/>
                                <Button Style="{StaticResource BtnChrome}" Tag="{StaticResource IconClose}"
                                        HorizontalAlignment="Right" Click="CloseAccount_Click"/>
                            </Grid>

                            <TextBlock Text="{Binding [saved_accounts], Source={x:Static loc:Loc.Instance}}" Style="{StaticResource Label}"/>
                            <ItemsControl x:Name="AccountsListBox" Margin="0,0,0,12">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource VersionCard}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Width="36" Height="36" CornerRadius="3" Background="#0F0F0F"
                                                        ClipToBounds="True" Margin="0,0,12,0">
                                                    <Image Source="{Binding AvatarUrl}" Stretch="UniformToFill"
                                                           RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                                                </Border>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding DisplayName}" Foreground="White"
                                                               FontWeight="SemiBold" FontSize="13"/>
                                                    <TextBlock Text="{Binding TypeLabel}" Foreground="{StaticResource TextMuted}"
                                                               FontSize="10" Margin="0,2,0,0"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Button Tag="{Binding Id}"
                                                            Content="{Binding [select], Source={x:Static loc:Loc.Instance}}"
                                                            Style="{StaticResource BtnSecondary}" Padding="12,6"
                                                            FontSize="10" Margin="0,0,6,0" Click="SelectAccount_Click"/>
                                                    <Button Tag="{Binding Id}" Style="{StaticResource BtnTrash}"
                                                            ToolTip="{Binding [remove_account_tip], Source={x:Static loc:Loc.Instance}}"
                                                            Click="DeleteAccount_Click"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="{Binding [add_offline_title], Source={x:Static loc:Loc.Instance}}" Style="{StaticResource Label}" Margin="0,6,0,4"/>
                            <TextBlock Text="{Binding [add_offline_desc], Source={x:Static loc:Loc.Instance}}" Style="{StaticResource RowDesc}"/>
                            <Grid Margin="0,0,0,18">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="NewAccountNameBox" Style="{StaticResource TB}" MaxLength="16" Margin="0,0,8,0"/>
                                <Button Grid.Column="1" Content="{Binding [add_offline_btn], Source={x:Static loc:Loc.Instance}}"
                                        Style="{StaticResource BtnSecondary}" Click="AddOfflineAccountConfirm_Click"/>
                            </Grid>

                            <TextBlock Text="{Binding [ms_account], Source={x:Static loc:Loc.Instance}}" Style="{StaticResource Label}" Margin="0,0,0,4"/>
                            <TextBlock Text="{Binding [ms_desc], Source={x:Static loc:Loc.Instance}}" Style="{StaticResource RowDesc}"/>
                            <Button x:Name="MicrosoftLoginButton"
                                    Content="{Binding [ms_signin], Source={x:Static loc:Loc.Instance}}"
                                    Style="{StaticResource BtnPrimary}" HorizontalAlignment="Stretch"
                                    Click="AddMicrosoftAccountConfirm_Click"/>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>

            <!-- ====== CONFIRMAR (apagar conta) ====== -->
            <Grid x:Name="ConfirmOverlay" Panel.ZIndex="250" Visibility="Collapsed" Background="#CC000000">
                <Border Style="{StaticResource Panel}" Width="420" Padding="26"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
                    <StackPanel>
                        <TextBlock x:Name="ConfirmTitle" Text="{Binding [confirm_action], Source={x:Static loc:Loc.Instance}}"
                                   Foreground="White" FontSize="19" FontWeight="Bold" Margin="0,0,0,8"/>
                        <TextBlock x:Name="ConfirmMessage" Text="{Binding [are_you_sure], Source={x:Static loc:Loc.Instance}}"
                                   Foreground="{StaticResource TextMuted}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,22"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="{Binding [cancel], Source={x:Static loc:Loc.Instance}}"
                                    Style="{StaticResource BtnSecondary}" MinWidth="100" Margin="0,0,10,0" Click="ConfirmCancel_Click"/>
                            <Button Content="{Binding [delete_btn], Source={x:Static loc:Loc.Instance}}"
                                    Style="{StaticResource BtnPrimary}" MinWidth="100" Click="ConfirmAccept_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            
            <Grid x:Name="ResourcesOverlay" Panel.ZIndex="300" Visibility="Collapsed" Background="#EE000000">
                <Border Style="{StaticResource Panel}" Width="460" Padding="28"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
                    <StackPanel>
                        <TextBlock Text="{Binding [resources_title], Source={x:Static loc:Loc.Instance}}"
                                   Foreground="White" FontSize="19" FontWeight="Bold" Margin="0,0,0,6"/>
                        <TextBlock x:Name="ResourcesStatusText" Text="{Binding [resources_checking], Source={x:Static loc:Loc.Instance}}"
                                   Foreground="{StaticResource TextMuted}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,18"/>
                        <ProgressBar x:Name="ResourcesProgress" Height="8" Minimum="0" Maximum="100" Value="0"
                                     Foreground="#5BC83E" Background="#0F0F0F" BorderThickness="0" Margin="0,0,0,8"/>
                        <TextBlock x:Name="ResourcesPercentText" Text="0%" Foreground="{StaticResource TextMuted}"
                                   FontSize="11" HorizontalAlignment="Right" Margin="0,0,0,6"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                            <Button x:Name="ResourcesSkipButton" Content="{Binding [skip], Source={x:Static loc:Loc.Instance}}"
                                    Style="{StaticResource BtnSecondary}" MinWidth="90" Margin="0,0,10,0"
                                    Visibility="Collapsed" Click="ResourcesSkip_Click"/>
                            <Button x:Name="ResourcesRetryButton" Content="{Binding [retry], Source={x:Static loc:Loc.Instance}}"
                                    Style="{StaticResource BtnPrimary}" MinWidth="90"
                                    Visibility="Collapsed" Click="ResourcesRetry_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
